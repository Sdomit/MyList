<Window x:Class="MyList.Views.CommandPaletteWindow"
        x:Name="PaletteRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MyList.Converters"
        xmlns:helpers="clr-namespace:MyList.Helpers"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:vm="clr-namespace:MyList.ViewModels"
        Title="Command Palette"
        Width="640"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource Token.TransparentBrush}"
        Foreground="{DynamicResource Token.TextPrimaryBrush}"
        FontFamily="{DynamicResource Token.FontUi}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Invert="True" />
        <helpers:SelectionInSectionConverter x:Key="SelectionInSectionConverter" />

        <Style x:Key="PaletteRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource Token.TransparentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Simple.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Token.RadiusMd}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Token.BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Token.AccentSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Palette.Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Token.FontMono}" />
            <Setter Property="FontSize" Value="{StaticResource Token.TextXs}" />
            <Setter Property="FontWeight" Value="{StaticResource Token.WeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource Token.TextTertiaryBrush}" />
        </Style>

        <DataTemplate x:Key="PaletteRowTemplate" DataType="{x:Type vm:IPaletteRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconLucide Kind="{Binding LucideKind}"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource Token.TextSecondaryBrush}">
                    <iconPacks:PackIconLucide.Style>
                        <Style TargetType="iconPacks:PackIconLucide">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverflow}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </iconPacks:PackIconLucide.Style>
                </iconPacks:PackIconLucide>

                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{StaticResource Token.TextSm}"
                               FontWeight="{StaticResource Token.WeightMedium}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Token.TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverflow}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Token.TextTertiaryBrush}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0"
                               FontFamily="{DynamicResource Token.FontMono}"
                               FontSize="{StaticResource Token.TextXs}"
                               Foreground="{DynamicResource Token.TextTertiaryBrush}"
                               Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Subtitle}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <ContentControl Grid.Column="2" Margin="0,0,8,0" Content="{Binding Shortcut}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource Chip.Kbd}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Shortcut}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <Grid Grid.Column="3" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Chip.Type}"
                                    Tag="{Binding Kind}" />
                    <Border Width="18"
                            Height="14"
                            CornerRadius="{StaticResource Token.RadiusXs}"
                            Background="{Binding BadgeBackground}"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BadgeLabel}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding BadgeLabel}"
                                   FontFamily="{DynamicResource Token.FontMono}"
                                   FontSize="{StaticResource Token.TextXs}"
                                   Foreground="{DynamicResource Token.TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource Token.BgSurfaceBrush}"
            BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Token.Radius2Xl}"
            Effect="{DynamicResource Token.ShadowXl}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconLucide Kind="Search"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                          VerticalAlignment="Center" />
                <DockPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                    <ItemsControl DockPanel.Dock="Left"
                                  ItemsSource="{Binding ActiveOperators}"
                                  VerticalAlignment="Center"
                                  MaxWidth="200"
                                  Margin="0,0,6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,2"
                                        Margin="0,0,4,0"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Token.BorderDefaultBrush}"
                                        Background="{DynamicResource Token.AccentSubtleBrush}"
                                        CornerRadius="{DynamicResource Token.RadiusSm}">
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{DynamicResource Token.FontMono}"
                                               FontSize="11"
                                               Foreground="{DynamicResource Token.TextAccentBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid>
                        <TextBox x:Name="QueryBox"
                                 Height="32"
                                 Padding="0"
                                 Background="{DynamicResource Token.TransparentBrush}"
                                 BorderThickness="0"
                                 FontSize="15"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                   FontSize="15"
                                   Text="Search items, commands, settings..."
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
                <ContentControl Grid.Column="2" Style="{StaticResource Chip.Kbd}" Content="Esc" />
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Background="{DynamicResource Token.BorderSubtleBrush}" />

            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,8,8,8">
                        <!-- Items section -->
                        <StackPanel Visibility="{Binding Items.HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="12,12,12,6">
                                <TextBlock Text="{Binding Items.Title}" Style="{StaticResource Palette.Eyebrow}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding Items.Rows.Count}"
                                           Style="{StaticResource Palette.Eyebrow}" />
                            </Grid>
                            <ListBox x:Name="ItemsList"
                                     ItemsSource="{Binding Items.Rows}"
                                     ItemTemplate="{StaticResource PaletteRowTemplate}"
                                     ItemContainerStyle="{StaticResource PaletteRowStyle}"
                                     BorderThickness="0"
                                     Background="{DynamicResource Token.TransparentBrush}"
                                     PreviewMouseLeftButtonUp="OnRowMouseUp">
                                <ListBox.SelectedItem>
                                    <MultiBinding Converter="{StaticResource SelectionInSectionConverter}" Mode="OneWay">
                                        <Binding Path="FocusedRow" />
                                        <Binding Path="Items" />
                                    </MultiBinding>
                                </ListBox.SelectedItem>
                            </ListBox>
                        </StackPanel>

                        <!-- Commands section -->
                        <StackPanel Visibility="{Binding Commands.HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="12,12,12,6">
                                <TextBlock Text="{Binding Commands.Title}" Style="{StaticResource Palette.Eyebrow}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding Commands.Rows.Count}"
                                           Style="{StaticResource Palette.Eyebrow}" />
                            </Grid>
                            <ListBox x:Name="CommandsList"
                                     ItemsSource="{Binding Commands.Rows}"
                                     ItemTemplate="{StaticResource PaletteRowTemplate}"
                                     ItemContainerStyle="{StaticResource PaletteRowStyle}"
                                     BorderThickness="0"
                                     Background="{DynamicResource Token.TransparentBrush}"
                                     PreviewMouseLeftButtonUp="OnRowMouseUp">
                                <ListBox.SelectedItem>
                                    <MultiBinding Converter="{StaticResource SelectionInSectionConverter}" Mode="OneWay">
                                        <Binding Path="FocusedRow" />
                                        <Binding Path="Commands" />
                                    </MultiBinding>
                                </ListBox.SelectedItem>
                            </ListBox>
                        </StackPanel>

                        <!-- Settings section -->
                        <StackPanel Visibility="{Binding Settings.HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="12,12,12,6">
                                <TextBlock Text="{Binding Settings.Title}" Style="{StaticResource Palette.Eyebrow}" />
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding Settings.Rows.Count}"
                                           Style="{StaticResource Palette.Eyebrow}" />
                            </Grid>
                            <ListBox x:Name="SettingsList"
                                     ItemsSource="{Binding Settings.Rows}"
                                     ItemTemplate="{StaticResource PaletteRowTemplate}"
                                     ItemContainerStyle="{StaticResource PaletteRowStyle}"
                                     BorderThickness="0"
                                     Background="{DynamicResource Token.TransparentBrush}"
                                     PreviewMouseLeftButtonUp="OnRowMouseUp">
                                <ListBox.SelectedItem>
                                    <MultiBinding Converter="{StaticResource SelectionInSectionConverter}" Mode="OneWay">
                                        <Binding Path="FocusedRow" />
                                        <Binding Path="Settings" />
                                    </MultiBinding>
                                </ListBox.SelectedItem>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Text="No results"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Token.TextSm}"
                           Foreground="{DynamicResource Token.TextTertiaryBrush}"
                           Visibility="{Binding HasAnyResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
            </Grid>

            <Border Grid.Row="3"
                    Padding="18,10"
                    Background="{DynamicResource Token.BgMicaBrush}"
                    BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Simple.MonoText}" Text="Up / Down" />
                    <TextBlock Margin="6,0,16,0"
                               Style="{StaticResource Simple.MetaText}"
                               Text="navigate" />
                    <TextBlock Style="{StaticResource Simple.MonoText}" Text="Enter" />
                    <TextBlock Margin="6,0,16,0"
                               Style="{StaticResource Simple.MetaText}"
                               Text="run" />
                    <TextBlock Style="{StaticResource Simple.MonoText}" Text="Esc" />
                    <TextBlock Margin="6,0,0,0"
                               Style="{StaticResource Simple.MetaText}"
                               Text="close" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
