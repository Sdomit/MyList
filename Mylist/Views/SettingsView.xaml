<UserControl x:Class="MyList.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:MyList.Helpers"
             Background="{DynamicResource Token.BgMicaBrush}"
             Foreground="{DynamicResource Token.TextPrimaryBrush}"
             FontFamily="{DynamicResource Token.FontUi}">
    <UserControl.Resources>
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Token.TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="{DynamicResource Token.TransparentBrush}"
                                    CornerRadius="{DynamicResource Token.RadiusMd}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                            <Border x:Name="ActiveBar"
                                    Width="2"
                                    Height="14"
                                    Margin="-6,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Token.AccentBrush}"
                                    CornerRadius="{DynamicResource Token.RadiusFull}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Token.BgHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Token.TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Token.BgActiveBrush}" />
                                <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Token.TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="Medium" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Token.TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource Token.FontDisplay}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingsSectionSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Token.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,18" />
        </Style>

        <Style x:Key="SettingsRow" TargetType="Border">
            <!-- Padding gives the row breathing room; MinHeight guarantees the toggle's
                 36×20 thumb + 2px Simple.FocusVisual margin (40×24) fits under any
                 density (HANDOFF §5 bug 1 — defensive close, PR #13 Part A repro deferral). -->
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="BorderBrush" Value="{DynamicResource Token.BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="SettingsRowName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Token.TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="SettingsRowDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Token.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,3,18,0" />
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Simple.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20">
                            <!-- Track gains an explicit BorderBrush so the OFF state is
                                 visible on light themes (BgMutedBrush is near-white there
                                 and disappears against the card). -->
                            <Border x:Name="Track"
                                    Background="{DynamicResource Token.BgMutedBrush}"
                                    BorderBrush="{DynamicResource Token.BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Token.RadiusFull}" />
                            <!-- Thumb gets a 1px Stroke for the same reason — a pure-white
                                 fill on a light track is otherwise invisible. -->
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Token.WhiteBrush}"
                                     Stroke="{DynamicResource Token.BorderStrongBrush}"
                                     StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Token.AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Token.AccentBrush}" />
                                <Setter TargetName="Thumb" Property="Margin" Value="19,0,0,0" />
                                <Setter TargetName="Thumb" Property="Stroke" Value="{DynamicResource Token.AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Simple.Card}">
            <Setter Property="Background" Value="{DynamicResource Token.BgSubtleBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Token.BgSurfaceBrush}"
            BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
            BorderThickness="1,0,0,0"
            CornerRadius="10,10,0,0">
        <TabControl x:Name="SettingsTabs"
                    Background="{DynamicResource Token.BgSurfaceBrush}"
                    BorderThickness="0"
                    TabStripPlacement="Left">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource Token.BgSubtleBrush}"
                                BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                BorderThickness="0,0,1,0">
                            <Grid Margin="8,18,8,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Margin="10,0,10,10"
                                           Style="{StaticResource Simple.SectionLabel}"
                                           Text="SETTINGS" />
                                <ItemsPresenter Grid.Row="1" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{DynamicResource Token.BgSurfaceBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource SettingsTabItem}" />
            </TabControl.Resources>

            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720"
                                Margin="32,24,32,40"
                                HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="General" />
                        <TextBlock Style="{StaticResource SettingsSectionSub}" Text="How MyList runs on this machine." />

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Launch on startup" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Open MyList minimized to the tray when you sign in." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="{Binding StartWithWindows}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Run in system tray" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Keep MyList resident when the window is minimized." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="{Binding MinimizeToTray}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Always on top" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Keep the main window above other applications." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="{Binding AlwaysOnTop}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Auto-hide to edge" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Hide docked MyList when the pointer leaves its edge." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="{Binding AutoHide}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Window layout" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Choose whether MyList docks, floats, or remains freely resizable." />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedItem="{Binding LayoutMode}"
                                          ItemsSource="{Binding LayoutModes}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720"
                                Margin="32,24,32,40"
                                HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Appearance" />
                        <TextBlock Style="{StaticResource SettingsSectionSub}" Text="Theme, density, and visual scale." />

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Follow system theme" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Use the current Windows light or dark appearance." />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="{Binding FollowSystemTheme}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Dark mode" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Use MyList's dark semantic token set." />
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          Style="{StaticResource SettingsToggle}"
                                          IsChecked="{Binding IsDarkMode}"
                                          IsEnabled="{Binding FollowSystemTheme, Converter={StaticResource InverseBooleanConverter}}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="App style" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Windows 11 follows the system look; MyList is the custom theme." />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedItem="{Binding Skin}"
                                          ItemsSource="{Binding SkinModes}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource UiSkinToLabelConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Accent" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Pick one of eight Forma accent palettes." />
                                </StackPanel>
                                <ListBox Grid.Column="1"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemsSource="{Binding AccentPalettes}"
                                         SelectedItem="{Binding Accent, Mode=TwoWay}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="3,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="ToolTip" Value="{Binding}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Ring"
                                                                Width="28" Height="28"
                                                                CornerRadius="14"
                                                                BorderThickness="2"
                                                                BorderBrush="Transparent"
                                                                Padding="2">
                                                            <Ellipse Fill="{Binding Converter={StaticResource AccentPaletteToBrushConverter}}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Token.AccentBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Token.BorderStrongBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Density" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Control the amount of breathing room around controls." />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedItem="{Binding UiDensity}"
                                          ItemsSource="{Binding DensityModes}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Item size" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Scale item content while retaining the compact Simple layout." />
                                </StackPanel>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0.75"
                                            Maximum="1.5"
                                            SmallChange="0.01"
                                            LargeChange="0.05"
                                            TickFrequency="0.05"
                                            Style="{StaticResource ThemedSliderStyle}"
                                            Value="{Binding ItemScale}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Style="{StaticResource Simple.MonoText}"
                                               Text="{Binding ItemScalePercentText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Collections layout" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Retained for compatibility with existing collection workflows." />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          SelectedItem="{Binding CollectionsLayout}"
                                          ItemsSource="{Binding CollectionsLayouts}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Item view mode" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Choose the preferred view when using legacy layouts." />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton Content="Grid"
                                                 Margin="0,0,14,0"
                                                 IsChecked="{Binding ViewMode, ConverterParameter=Grid, Converter={StaticResource EnumToBooleanConverter}}" />
                                    <RadioButton Content="List"
                                                 IsChecked="{Binding ViewMode, ConverterParameter=List, Converter={StaticResource EnumToBooleanConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720"
                                Margin="32,24,32,40"
                                HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Hotkeys" />
                        <TextBlock Style="{StaticResource SettingsSectionSub}" Text="Global shortcuts wired through Windows." />

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Summon launcher" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Click the field and press a new global shortcut." />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding GlobalHotkeyDisplay, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="{DynamicResource Token.FontMono}"
                                             PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource Simple.MonoText}"
                                               Text="{Binding HotkeyStatusMessage}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Quick menu (mini-launcher)" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Global shortcut for the orbit picker. Click the field and press a new shortcut." />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding MiniLauncherHotkeyDisplay, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="{DynamicResource Token.FontMono}"
                                             PreviewKeyDown="OnMiniLauncherHotkeyPreviewKeyDown" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,18,0,0"
                                Padding="12"
                                Background="{DynamicResource Token.AccentSubtleBrush}"
                                BorderBrush="{DynamicResource Token.AccentMutedBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Token.RadiusMd}">
                            <TextBlock Foreground="{DynamicResource Token.TextSecondaryBrush}"
                                       FontSize="12"
                                       Text="Ctrl+K opens commands, Ctrl+T toggles theme, Ctrl+D finds duplicates, and Ctrl+Shift+V reviews clipboard paths."
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Data &amp; sync">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720"
                                Margin="32,24,32,40"
                                HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Data &amp; sync" />
                        <TextBlock Style="{StaticResource SettingsSectionSub}" Text="Export, import, and recover your collections." />

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Export collections" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Create a schema-versioned bundle including clipboard assets." />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Export..." Command="{Binding ExportCommand}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Import collections" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Merge or replace from a previous export." />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Import..." Command="{Binding ImportCommand}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Restore from backup" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Recover from MyList's retained local snapshots." />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Restore..." Command="{Binding RestoreBackupCommand}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,18,0,0" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="LOCAL STORE" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="{DynamicResource Token.FontMono}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Token.TextSecondaryBrush}"
                                           Text="%AppData%\MyList" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720"
                                Margin="32,24,32,40"
                                HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="Tools &amp; diagnostics" />
                        <TextBlock Style="{StaticResource SettingsSectionSub}" Text="Inspect services, repair integration, and manage duplicate entries." />

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Duplicate manager" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Find repeated paths and choose the survivor for each group." />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenDuplicateManagerCommand}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Live diagnostics" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="Review hotkey, tray, network, and Explorer integration status." />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenDiagnosticsCommand}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Verbose Mtab diagnostics" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="{Binding DebugModeStatusText}" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="{Binding EnableDebugMode}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingsRowName}" Text="Debug report" />
                                    <TextBlock Style="{StaticResource SettingsRowDesc}" Text="{Binding DebugCopyStatus}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy report" Command="{Binding CopyDebugReportCommand}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,20,0,0" Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="EXPLORER INTEGRATION" />
                                <TextBlock Margin="0,8,0,12"
                                           Style="{StaticResource Simple.MetaText}"
                                           Text="{Binding ExplorerIntegrationStatusText}"
                                           TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Content="Install" Command="{Binding InstallExplorerIntegrationCommand}" Margin="0,0,6,6" />
                                    <Button Content="Repair" Command="{Binding RepairExplorerIntegrationCommand}" Margin="0,0,6,6" />
                                    <Button Content="Uninstall" Style="{StaticResource Simple.GhostButton}" Command="{Binding UninstallExplorerIntegrationCommand}" Margin="0,0,6,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720"
                                Margin="32,24,32,40"
                                HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource SettingsSectionTitle}" Text="About" />
                        <TextBlock Style="{StaticResource SettingsSectionSub}" Text="MyList, a keyboard-first launcher for Windows." />

                        <Border Style="{StaticResource SettingsCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="56"
                                        Height="56"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Token.AccentBrush}"
                                        CornerRadius="{DynamicResource Token.Radius2Xl}">
                                    <TextBlock Text="ML"
                                               Foreground="{DynamicResource Token.AccentForegroundBrush}"
                                               FontFamily="{DynamicResource Token.FontDisplay}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Simple.PaneTitle}" Text="MyList" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource Simple.MetaText}"
                                               Text="Simple variant UI redesign" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource Simple.MonoText}"
                                               Foreground="{DynamicResource Token.TextAccentBrush}"
                                               Text="{x:Static helpers:BuildInfo.DisplayString}" />
                                    <TextBlock Margin="0,12,0,0"
                                               Style="{StaticResource Simple.MonoText}"
                                               Text=".NET 8.0 / WPF / Windows"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsRowName}" Text="Author" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Simple.PaneTitle}"
                                           Text="Sarmad Domit" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource Simple.MetaText}">
                                    <Hyperlink NavigateUri="https://www.sarmaddomit.com"
                                               RequestNavigate="OnHyperlinkRequestNavigate"
                                               Foreground="{DynamicResource Token.TextAccentBrush}">
                                        www.sarmaddomit.com
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Border>
</UserControl>
