<UserControl x:Class="MyList.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,2,2">
                <TextBlock Text="Settings"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Theme"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Follow system theme"
                              IsChecked="{Binding FollowSystemTheme}"
                              Margin="0,0,0,6" />
                    <CheckBox Content="Dark mode"
                              IsChecked="{Binding IsDarkMode}"
                              IsEnabled="{Binding FollowSystemTheme, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="View mode"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Grid"
                                     Margin="0,0,16,0"
                                     IsChecked="{Binding ViewMode, ConverterParameter=Grid, Converter={StaticResource EnumToBooleanConverter}}" />
                        <RadioButton Content="List"
                                     IsChecked="{Binding ViewMode, ConverterParameter=List, Converter={StaticResource EnumToBooleanConverter}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Layout mode"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ComboBox MinHeight="32"
                              HorizontalAlignment="Stretch"
                              SelectedItem="{Binding LayoutMode}"
                              ItemsSource="{Binding LayoutModes}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Collections layout"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ComboBox MinHeight="32"
                              HorizontalAlignment="Stretch"
                              SelectedItem="{Binding CollectionsLayout}"
                              ItemsSource="{Binding CollectionsLayouts}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Density"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <ComboBox MinHeight="32"
                              HorizontalAlignment="Stretch"
                              SelectedItem="{Binding UiDensity}"
                              ItemsSource="{Binding DensityModes}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Item size"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0"
                                Style="{StaticResource ThemedSliderStyle}"
                                Minimum="0.75"
                                Maximum="1.5"
                                SmallChange="0.01"
                                LargeChange="0.05"
                                TickFrequency="0.05"
                                Value="{Binding ItemScale}" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding ItemScalePercentText}" />
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Behavior"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Always on top"
                              IsChecked="{Binding AlwaysOnTop}"
                              Margin="0,0,0,6" />
                    <CheckBox Content="Auto-hide to edge"
                              IsChecked="{Binding AutoHide}"
                              Margin="0,0,0,6" />
                    <CheckBox Content="Minimize to tray"
                              IsChecked="{Binding MinimizeToTray}"
                              Margin="0,0,0,6" />
                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Global hotkey"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBox MinHeight="32"
                             HorizontalAlignment="Stretch"
                             Text="{Binding GlobalHotkeyDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding HotkeyStatusMessage}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Tools"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Button Content="Duplicate Manager"
                            Style="{StaticResource SettingsActionButton}"
                            Command="{Binding OpenDuplicateManagerCommand}" />
                    <Button Content="Diagnostics"
                            Style="{StaticResource SettingsActionButton}"
                            Margin="0"
                            Command="{Binding OpenDiagnosticsCommand}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Debug"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <CheckBox Content="Enable debug mode (verbose Mtab logs)"
                              IsChecked="{Binding EnableDebugMode}"
                              Margin="0,0,0,6" />
                    <TextBlock Text="{Binding DebugModeStatusText}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <Button Content="Copy Debug Report"
                            Style="{StaticResource SettingsActionButton}"
                            Margin="0"
                            Command="{Binding CopyDebugReportCommand}" />
                    <TextBlock Text="{Binding DebugCopyStatus}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Explorer Integration"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ExplorerIntegrationStatusText}"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <Button Content="Install Explorer Menu"
                            Style="{StaticResource SettingsActionButton}"
                            Command="{Binding InstallExplorerIntegrationCommand}" />
                    <Button Content="Uninstall Explorer Menu"
                            Style="{StaticResource SettingsActionButton}"
                            Command="{Binding UninstallExplorerIntegrationCommand}" />
                    <Button Content="Repair Explorer Menu"
                            Style="{StaticResource SettingsActionButton}"
                            Margin="0"
                            Command="{Binding RepairExplorerIntegrationCommand}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Data"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <Button Content="Export"
                            Style="{StaticResource SettingsActionButton}"
                            Command="{Binding ExportCommand}" />
                    <Button Content="Import"
                            Style="{StaticResource SettingsActionButton}"
                            Command="{Binding ImportCommand}" />
                    <Button Content="Restore backup"
                            Style="{StaticResource SettingsActionButton}"
                            Margin="0"
                            Command="{Binding RestoreBackupCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
