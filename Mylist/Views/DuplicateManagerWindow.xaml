<Window x:Class="MyList.Views.DuplicateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Manager"
        Width="840"
        Height="620"
        MinWidth="720"
        MinHeight="520"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner">
    <Border Margin="12"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Duplicate Manager"
                           FontSize="18"
                           FontWeight="SemiBold" />

                <Grid Grid.Row="1"
                      Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{Binding Groups.Count, StringFormat=Detected duplicate groups: {0}}" />

                    <WrapPanel Grid.Column="1"
                               HorizontalAlignment="Right">
                        <Button Content="Refresh"
                                Style="{StaticResource HeaderActionButton}"
                                Command="{Binding RefreshCommand}" />
                        <Button Content="Merge Selected"
                                Style="{StaticResource HeaderActionButton}"
                                Command="{Binding MergeSelectedGroupCommand}" />
                        <Button Content="Merge All"
                                Style="{StaticResource HeaderActionButton}"
                                Margin="0"
                                Command="{Binding MergeAllCommand}" />
                    </WrapPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource SurfaceElevated}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Duplicate Groups"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Groups}"
                                 SelectedItem="{Binding SelectedGroup}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding DisplayPath}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayPath}" />
                                        <TextBlock Text="{Binding Items.Count, StringFormat={}{0} items}"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceElevated}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Survivor"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       FontWeight="SemiBold" />
                            <ComboBox Grid.Column="1"
                                      MinHeight="32"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding SelectedGroup.Items}"
                                      SelectedItem="{Binding SelectedGroup.SelectedSurvivor}"
                                      DisplayMemberPath="Name" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 Margin="0,10,0,0"
                                 ItemsSource="{Binding SelectedGroup.Items}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Path}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Button Grid.Row="2"
                    Content="Close"
                    Width="100"
                    HorizontalAlignment="Right"
                    Click="OnClose" />
        </Grid>
    </Border>
</Window>
