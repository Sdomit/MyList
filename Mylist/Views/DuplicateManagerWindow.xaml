<Window x:Class="MyList.Views.DuplicateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicates"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        Background="{DynamicResource Token.BgMicaBrush}"
        Foreground="{DynamicResource Token.TextPrimaryBrush}"
        FontFamily="{DynamicResource Token.FontUi}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Simple.Button}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource Simple.TextBox}" />
        <DataTemplate x:Key="DuplicateGroupTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DisplayPath}"
                           FontFamily="{DynamicResource Token.FontMono}"
                           FontSize="11.5"
                           Foreground="{DynamicResource Token.TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplayPath}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{DynamicResource Token.StatusWarnBrush}"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Simple.MonoText}"
                               Text="{Binding Items.Count, StringFormat={}{0} copies}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DuplicateItemTemplate">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24"
                        Height="24"
                        Background="{DynamicResource Token.TypeFileBackgroundBrush}"
                        BorderBrush="{DynamicResource Token.TypeFileBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Token.RadiusMd}">
                    <Image Width="15"
                           Height="15"
                           Source="{Binding Icon}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource Token.TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,0,0"
                               Style="{StaticResource Simple.MonoText}"
                               Text="{Binding Path}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Path}" />
                </StackPanel>
                <Border Grid.Column="2"
                        Padding="6,2"
                        Background="{DynamicResource Token.BgSubtleBrush}"
                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Token.RadiusXs}"
                        VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Simple.MonoText}" Text="{Binding Type}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="{DynamicResource Token.BgSurfaceBrush}"
                BorderBrush="{DynamicResource Token.BorderHairBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Token.Radius2Xl}"
                Effect="{DynamicResource Token.ShadowLg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="24,18,20,14"
                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Simple.PaneTitle}" Text="Duplicates" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Simple.MetaText}"
                                           Text="{Binding Groups.Count, StringFormat={}{0} duplicate groups}" />
                                <Ellipse Width="2"
                                         Height="2"
                                         Margin="8,0"
                                         Fill="{DynamicResource Token.TextTertiaryBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Simple.MetaText}" Text="same normalized path" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="Rescan"
                                    Command="{Binding RefreshCommand}" />
                            <Button Content="Merge selected"
                                    Margin="6,0,0,0"
                                    Command="{Binding MergeSelectedGroupCommand}" />
                            <Button Content="Merge all"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource Simple.DangerButton}"
                                    Command="{Binding MergeAllCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,18,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Simple.Card}"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Padding="12,10"
                                    Background="{DynamicResource Token.BgSubtleBrush}"
                                    BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="DUPLICATE GROUPS" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource Simple.MetaText}"
                                               Text="Select a group to choose its survivor" />
                                </StackPanel>
                            </Border>

                            <ListBox Grid.Row="1"
                                     Margin="6"
                                     ItemsSource="{Binding Groups}"
                                     SelectedItem="{Binding SelectedGroup}"
                                     ItemTemplate="{StaticResource DuplicateGroupTemplate}"
                                     ItemContainerStyle="{StaticResource Simple.ItemListBoxItem}" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource Simple.Card}"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="14,12"
                                    Background="{DynamicResource Token.BgSubtleBrush}"
                                    BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="SELECTED GROUP" />
                                        <TextBlock Margin="0,5,16,0"
                                                   FontFamily="{DynamicResource Token.FontMono}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource Token.TextPrimaryBrush}"
                                                   Text="{Binding SelectedGroup.DisplayPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedGroup.DisplayPath}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="7,3"
                                            Background="{DynamicResource Token.StatusWarnBackgroundBrush}"
                                            CornerRadius="{DynamicResource Token.RadiusXs}"
                                            VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource Token.StatusWarnBrush}"
                                                   FontFamily="{DynamicResource Token.FontMono}"
                                                   FontSize="10.5"
                                                   Text="{Binding SelectedGroup.Items.Count, StringFormat={}{0} COPIES}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Padding="14,10"
                                    BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="12.5"
                                                   FontWeight="Medium"
                                                   Text="Survivor" />
                                        <TextBlock Margin="0,3,16,0"
                                                   Style="{StaticResource Simple.MetaText}"
                                                   Text="Metadata and collection links are merged into this item."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding SelectedGroup.Items}"
                                              SelectedItem="{Binding SelectedGroup.SelectedSurvivor}"
                                              DisplayMemberPath="Name"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding SelectedGroup.Items}"
                                     ItemTemplate="{StaticResource DuplicateItemTemplate}"
                                     IsHitTestVisible="False">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Token.BorderHairBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Padding="20,12"
                        Background="{DynamicResource Token.BgMicaBrush}"
                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Style="{StaticResource Simple.MetaText}"
                                   Text="Merging preserves the selected survivor and rewires collection and Mtab references."
                                   VerticalAlignment="Center" />
                        <Button Width="90"
                                HorizontalAlignment="Right"
                                Content="Close"
                                Style="{StaticResource Simple.GhostButton}"
                                Click="OnClose" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
