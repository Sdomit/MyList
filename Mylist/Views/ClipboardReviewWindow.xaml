<Window x:Class="MyList.Views.ClipboardReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard inbox"
        Width="980"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        Background="{DynamicResource Token.BgMicaBrush}"
        Foreground="{DynamicResource Token.TextPrimaryBrush}"
        FontFamily="{DynamicResource Token.FontUi}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="ClipboardSectionCard" TargetType="Border" BasedOn="{StaticResource Simple.Card}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <DataTemplate x:Key="ClipboardPathRow">
            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7"
                         Height="7"
                         Fill="{DynamicResource Token.StatusOkBrush}"
                         VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock FontFamily="{DynamicResource Token.FontMono}"
                               FontSize="11.5"
                               Foreground="{DynamicResource Token.TextPrimaryBrush}"
                               Text="{Binding DisplayPath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DisplayPath}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="10.5"
                               Foreground="{DynamicResource Token.TextTertiaryBrush}"
                               Text="{Binding Reason}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SkippedPathRow">
            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7"
                         Height="7"
                         Fill="{DynamicResource Token.StatusBadBrush}"
                         VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock FontFamily="{DynamicResource Token.FontMono}"
                               FontSize="11.5"
                               Foreground="{DynamicResource Token.TextPrimaryBrush}"
                               Text="{Binding DisplayPath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DisplayPath}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="10.5"
                               Foreground="{DynamicResource Token.StatusBadBrush}"
                               Text="{Binding Reason}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="{DynamicResource Token.BgSurfaceBrush}"
                BorderBrush="{DynamicResource Token.BorderHairBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Token.Radius2Xl}"
                Effect="{DynamicResource Token.ShadowLg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="24,18,20,14"
                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Simple.PaneTitle}" Text="Clipboard inbox" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Simple.MetaText}" Text="{Binding SummaryText}" />
                                <Ellipse Width="2"
                                         Height="2"
                                         Margin="8,0"
                                         Fill="{DynamicResource Token.TextTertiaryBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Simple.MetaText}" Text="review before adding" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Margin="0,0,8,0"
                                       Style="{StaticResource Simple.MetaText}"
                                       Text="Add to"
                                       VerticalAlignment="Center" />
                            <ComboBox Width="210"
                                      ItemsSource="{Binding AvailableCollections}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedTargetCollection}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,18,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource ClipboardSectionCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="12,9"
                                            Background="{DynamicResource Token.BgSubtleBrush}"
                                            BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Style="{StaticResource Simple.SectionLabel}"
                                                       Foreground="{DynamicResource Token.StatusOkBrush}"
                                                       Text="{Binding WillAddHeader}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource Simple.MonoText}"
                                                       Text="NEW PATHS" />
                                        </Grid>
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding WillAddEntries}"
                                             ItemTemplate="{StaticResource ClipboardPathRow}"
                                             IsHitTestVisible="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Token.BorderHairBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ClipboardSectionCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="12,9"
                                            Background="{DynamicResource Token.BgSubtleBrush}"
                                            BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Style="{StaticResource Simple.SectionLabel}"
                                                       Foreground="{DynamicResource Token.AccentBrush}"
                                                       Text="{Binding WillLinkHeader}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource Simple.MonoText}"
                                                       Text="EXISTING ITEMS" />
                                        </Grid>
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding WillLinkEntries}"
                                             ItemTemplate="{StaticResource ClipboardPathRow}"
                                             IsHitTestVisible="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ClipboardSectionCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Padding="12,9"
                                            Background="{DynamicResource Token.BgSubtleBrush}"
                                            BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <TextBlock Style="{StaticResource Simple.SectionLabel}"
                                                       Foreground="{DynamicResource Token.StatusBadBrush}"
                                                       Text="{Binding SkippedHeader}" />
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource Simple.MonoText}"
                                                       Text="SKIPPED" />
                                        </Grid>
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SkippedEntries}"
                                             ItemTemplate="{StaticResource SkippedPathRow}"
                                             IsHitTestVisible="False">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="2"
                            Style="{StaticResource Simple.Card}"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Padding="12,10"
                                    Background="{DynamicResource Token.BgSubtleBrush}"
                                    BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="CLIPBOARD HISTORY" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource Simple.MetaText}"
                                               Text="Re-apply a recent import" />
                                </StackPanel>
                            </Border>

                            <ListBox x:Name="HistoryList"
                                     Grid.Row="1"
                                     Margin="6"
                                     ItemsSource="{Binding HistoryEntries}"
                                     SelectedItem="{Binding SelectedHistoryEntry}"
                                     ItemContainerStyle="{StaticResource Simple.ItemListBoxItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CollectionName}"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource Simple.MetaText}"
                                                       Text="{Binding Summary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource Simple.MonoText}"
                                                       Text="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Grid.Row="2"
                                    Margin="10"
                                    Content="Re-apply selected"
                                    Click="OnReapplyHistory" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Padding="20,12"
                        Background="{DynamicResource Token.BgMicaBrush}"
                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Style="{StaticResource Simple.MetaText}"
                                   Text="Only valid rooted paths are applied. Clipboard text and image items are handled immediately."
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Width="88"
                                    Style="{StaticResource Simple.GhostButton}"
                                    Click="OnCancel" />
                            <Button Content="{Binding ConfirmButtonText}"
                                    Width="180"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanConfirm}"
                                    Click="OnConfirm" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
