<Window x:Class="MyList.Views.ClipboardReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Clipboard Items"
        Width="860"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3"
                   Text="Review clipboard import"
                   FontSize="18"
                   Foreground="{DynamicResource TextPrimary}"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1"
              Grid.ColumnSpan="3"
              Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding SummaryText}"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="Add to"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <ComboBox Width="180"
                          ItemsSource="{Binding AvailableCollections}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedTargetCollection}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding WillAddHeader}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding WillAddEntries}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding DisplayPath}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding WillLinkHeader}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding WillLinkEntries}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding DisplayPath}" />
                                        <TextBlock Text="{Binding Reason}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding SkippedHeader}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding SkippedEntries}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Reason}"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="11"
                                                   Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding DisplayPath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DisplayPath}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Grid.Column="2"
                Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Clipboard history"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <ListBox x:Name="HistoryList"
                         Grid.Row="1"
                         ItemsSource="{Binding HistoryEntries}"
                         SelectedItem="{Binding SelectedHistoryEntry}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding CollectionName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                <TextBlock Text="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="10" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="2"
                        Content="Re-apply Selected"
                        Margin="0,10,0,0"
                        Click="OnReapplyHistory" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="OnCancel" />
            <Button Content="{Binding ConfirmButtonText}"
                    Width="180"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanConfirm}"
                    Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
