<UserControl x:Class="MyList.Views.DuplicateManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Token.TransparentBrush}"
             Foreground="{DynamicResource Token.TextPrimaryBrush}"
             FontFamily="{DynamicResource Token.FontUi}">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Simple.Button}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource Simple.TextBox}" />
        <DataTemplate x:Key="DuplicateGroupTemplate">
            <StackPanel>
                <TextBlock Style="{StaticResource Simple.MonoText}"
                           Foreground="{DynamicResource Token.TextPrimaryBrush}"
                           Text="{Binding DisplayPath}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplayPath}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Simple.MetaText}"
                           Text="{Binding Items.Count, StringFormat={}{0} copies}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DuplicateItemTemplate">
            <Grid Margin="12,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="24"
                        Height="24"
                        Background="{DynamicResource Token.TypeFileBackgroundBrush}"
                        BorderBrush="{DynamicResource Token.TypeFileBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Token.RadiusMd}">
                    <Image Width="15"
                           Height="15"
                           Source="{Binding Icon}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,12,0">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,0,0"
                               Style="{StaticResource Simple.MonoText}"
                               Text="{Binding Path}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Path}" />
                </StackPanel>
                <Border Grid.Column="2"
                        Padding="6,2"
                        Background="{DynamicResource Token.BgSubtleBrush}"
                        BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Token.RadiusXs}"
                        VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Simple.MonoText}" Text="{Binding Type}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Margin="0,8,12,8"
            Style="{StaticResource Simple.Pane}"
            CornerRadius="{DynamicResource Token.RadiusXl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="20,16"
                    BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Simple.PaneTitle}" Text="Duplicates" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource Simple.MetaText}"
                                   Text="{Binding DuplicateManager.Groups.Count, StringFormat={}{0} duplicate groups}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Rescan" Command="{Binding DuplicateManager.RefreshCommand}" />
                        <Button Margin="6,0,0,0"
                                Content="Merge selected"
                                Command="{Binding DuplicateManager.MergeSelectedGroupCommand}" />
                        <Button Margin="6,0,0,0"
                                Content="Merge all"
                                Style="{StaticResource Simple.DangerButton}"
                                Command="{Binding DuplicateManager.MergeAllCommand}" />
                        <Button Margin="6,0,0,0"
                                Content="Back"
                                Style="{StaticResource Simple.GhostButton}"
                                Command="{Binding CloseToolPaneCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" MaxWidth="285" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Simple.Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="10,9"
                                Background="{DynamicResource Token.BgSubtleBrush}"
                                BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="DUPLICATE GROUPS" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource Simple.MetaText}"
                                           Text="Select a group to choose its survivor" />
                            </StackPanel>
                        </Border>
                        <ListBox Grid.Row="1"
                                 Margin="5"
                                 ItemsSource="{Binding DuplicateManager.Groups}"
                                 SelectedItem="{Binding DuplicateManager.SelectedGroup}"
                                 ItemTemplate="{StaticResource DuplicateGroupTemplate}"
                                 ItemContainerStyle="{StaticResource Simple.ItemListBoxItem}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Simple.Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="12,10"
                                Background="{DynamicResource Token.BgSubtleBrush}"
                                BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="SELECTED GROUP" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Simple.MonoText}"
                                           Foreground="{DynamicResource Token.TextPrimaryBrush}"
                                           Text="{Binding DuplicateManager.SelectedGroup.DisplayPath}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DuplicateManager.SelectedGroup.DisplayPath}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1"
                                Padding="12,9"
                                BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="Medium" Text="Survivor" />
                                    <TextBlock Margin="0,3,16,0"
                                               Style="{StaticResource Simple.MetaText}"
                                               Text="Metadata and collection links are merged into this item."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DuplicateManager.SelectedGroup.Items}"
                                          SelectedItem="{Binding DuplicateManager.SelectedGroup.SelectedSurvivor}"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding DuplicateManager.SelectedGroup.Items}"
                                 ItemTemplate="{StaticResource DuplicateItemTemplate}"
                                 IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Padding="16,10"
                    Background="{DynamicResource Token.BgMicaBrush}"
                    BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock Style="{StaticResource Simple.MetaText}"
                           Text="Merging preserves the selected survivor and rewires collection and Mtab references." />
            </Border>
        </Grid>
    </Border>
</UserControl>
