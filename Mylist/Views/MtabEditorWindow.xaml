<Window x:Class="MyList.Views.MtabEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mtab Editor"
        Width="860"
        Height="660"
        MinWidth="760"
        MinHeight="580"
        Background="{DynamicResource Token.BgMicaBrush}"
        Foreground="{DynamicResource Token.TextPrimaryBrush}"
        FontFamily="{DynamicResource Token.FontUi}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <DataTemplate x:Key="MtabPathRowTemplate">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="20"
                        Height="20"
                        Background="{DynamicResource Token.AccentSoftBrush}"
                        CornerRadius="{DynamicResource Token.RadiusSm}"
                        VerticalAlignment="Top"
                        Margin="0,6,0,0">
                    <TextBlock Text="{Binding Number}"
                               Foreground="{DynamicResource Token.TextAccentBrush}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBox FontFamily="{DynamicResource Token.FontMono}"
                             FontSize="11.5"
                             Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="2,3,0,0"
                               FontSize="10.5"
                               Foreground="{DynamicResource Token.TextTertiaryBrush}"
                               Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MtabValidationTemplate">
            <Border Margin="0,0,0,6"
                    Padding="9,7"
                    Background="{DynamicResource Token.BgSubtleBrush}"
                    BorderBrush="{DynamicResource Token.BorderHairBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Token.RadiusMd}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11.5"
                                   FontWeight="Medium" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource Simple.MonoText}"
                                   Text="{Binding Input}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Input}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="6,2"
                            Background="{DynamicResource Token.AccentSoftBrush}"
                            CornerRadius="{DynamicResource Token.RadiusXs}"
                            VerticalAlignment="Center">
                        <TextBlock FontFamily="{DynamicResource Token.FontMono}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource Token.TextAccentBrush}"
                                   Text="{Binding Message}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="{DynamicResource Token.BgSurfaceBrush}"
                BorderBrush="{DynamicResource Token.BorderHairBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Token.Radius2Xl}"
                Effect="{DynamicResource Token.ShadowLg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="22,18,20,14"
                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Simple.PaneTitle}" Text="{Binding DialogTitle}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Simple.MetaText}"
                                       Text="Build an Explorer tab group from local folders and UNC paths." />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="7,3"
                                Background="{DynamicResource Token.AccentSoftBrush}"
                                BorderBrush="{DynamicResource Token.AccentMuteBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Token.RadiusXs}"
                                VerticalAlignment="Top">
                            <TextBlock FontFamily="{DynamicResource Token.FontMono}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Token.TextAccentBrush}"
                                       Text="{Binding SummaryText}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="20,18,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="310" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="MTAB NAME" />
                        <TextBox Grid.Row="1"
                                 Margin="0,7,0,16"
                                 Text="{Binding MtabName, UpdateSourceTrigger=PropertyChanged}" />

                        <Border Grid.Row="2"
                                Style="{StaticResource Simple.Card}"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="12,10"
                                        Background="{DynamicResource Token.BgSubtleBrush}"
                                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="FOLDERS" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource Simple.MetaText}"
                                                       Text="A blank row appears as you type" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right"
                                                Padding="6,2"
                                                Background="{DynamicResource Token.BgSurfaceBrush}"
                                                BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Token.RadiusXs}"
                                                VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Simple.MonoText}"
                                                       Text="{Binding PathEntries.Count, StringFormat={}{0} rows}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <ScrollViewer x:Name="PathRowsScrollViewer"
                                              Grid.Row="1"
                                              Padding="12,12,12,6"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False">
                                    <ItemsControl ItemsSource="{Binding PathEntries}"
                                                  ItemTemplate="{StaticResource MtabPathRowTemplate}" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="196" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="PREVIEW" Margin="0,0,0,8" />

                        <Border Grid.Row="1"
                                Background="{DynamicResource Token.BgSubtleBrush}"
                                BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Token.RadiusMd}"
                                ClipToBounds="True">
                            <Canvas Width="286" Height="194">
                                <Line X1="143" Y1="97" X2="143" Y2="30"
                                      Stroke="{DynamicResource Token.AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeDashArray="3,3"
                                      Opacity="0.4" />
                                <Line X1="143" Y1="97" X2="212" Y2="132"
                                      Stroke="{DynamicResource Token.AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeDashArray="3,3"
                                      Opacity="0.4" />
                                <Line X1="143" Y1="97" X2="74" Y2="132"
                                      Stroke="{DynamicResource Token.AccentBrush}"
                                      StrokeThickness="1.5"
                                      StrokeDashArray="3,3"
                                      Opacity="0.4" />

                                <Ellipse Canvas.Left="138"
                                         Canvas.Top="92"
                                         Width="10"
                                         Height="10"
                                         Fill="{DynamicResource Token.AccentBrush}" />
                                <Ellipse Canvas.Left="131"
                                         Canvas.Top="85"
                                         Width="24"
                                         Height="24"
                                         Stroke="{DynamicResource Token.AccentMuteBrush}"
                                         StrokeThickness="5" />

                                <Border Canvas.Left="127"
                                        Canvas.Top="14"
                                        Width="32"
                                        Height="32"
                                        Background="{DynamicResource Token.BgSurfaceBrush}"
                                        BorderBrush="{DynamicResource Token.AccentBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="{DynamicResource Token.RadiusLg}">
                                    <TextBlock Text="1"
                                               Foreground="{DynamicResource Token.TextAccentBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border Canvas.Left="196"
                                        Canvas.Top="116"
                                        Width="32"
                                        Height="32"
                                        Background="{DynamicResource Token.BgSurfaceBrush}"
                                        BorderBrush="{DynamicResource Token.AccentBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="{DynamicResource Token.RadiusLg}">
                                    <TextBlock Text="2"
                                               Foreground="{DynamicResource Token.TextAccentBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border Canvas.Left="58"
                                        Canvas.Top="116"
                                        Width="32"
                                        Height="32"
                                        Background="{DynamicResource Token.BgSurfaceBrush}"
                                        BorderBrush="{DynamicResource Token.AccentBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="{DynamicResource Token.RadiusLg}">
                                    <TextBlock Text="3"
                                               Foreground="{DynamicResource Token.TextAccentBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <Border Canvas.Left="110"
                                        Canvas.Top="160"
                                        Padding="6,2"
                                        Background="{DynamicResource Token.BgSurfaceBrush}"
                                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Token.RadiusXs}">
                                    <TextBlock Style="{StaticResource Simple.MonoText}"
                                               Text="{Binding SummaryText}" />
                                </Border>
                            </Canvas>
                        </Border>

                        <Border Grid.Row="3"
                                Style="{StaticResource Simple.Card}"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Padding="12,10"
                                        Background="{DynamicResource Token.BgSubtleBrush}"
                                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                                        BorderThickness="0,0,0,1">
                                    <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="VALIDATION" />
                                </Border>
                                <ListBox Grid.Row="1"
                                         Margin="8"
                                         ItemsSource="{Binding ValidationEntries}"
                                         ItemTemplate="{StaticResource MtabValidationTemplate}"
                                         IsHitTestVisible="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        Padding="20,12"
                        Background="{DynamicResource Token.BgMicaBrush}"
                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Style="{StaticResource Simple.MetaText}"
                                   Text="Only local folders and UNC paths are allowed. At least two valid folders are required."
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Width="90"
                                    Style="{StaticResource Simple.GhostButton}"
                                    Click="OnCancel" />
                            <Button Content="{Binding ConfirmButtonText}"
                                    Width="120"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="OnSave" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
