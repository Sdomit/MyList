<Window x:Class="MyList.Views.DropItemActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Action"
        Width="500"
        MinWidth="500"
        SizeToContent="Height"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Margin="12"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <StackPanel>
            <TextBlock Text="Drop Action"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,10,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Text="{Binding Prompt}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Create Mtab"
                        Style="{StaticResource HeaderPrimaryActionButton}"
                        MinWidth="130"
                        MinHeight="34"
                        Margin="0,0,8,0"
                        Click="OnCreateMtab" />
                <Button Grid.Column="1"
                        Content="Create Collection"
                        Style="{StaticResource HeaderActionButton}"
                        MinWidth="154"
                        MinHeight="34"
                        Margin="0,0,8,0"
                        Click="OnCreateCollection" />
                <Button Grid.Column="2"
                        Content="Cancel"
                        Style="{StaticResource HeaderActionButton}"
                        MinWidth="96"
                        MinHeight="34"
                        Margin="0"
                        Click="OnCancel" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
