<Window x:Class="MyList.Views.MtabPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Mtab"
        FocusManager.FocusedElement="{Binding ElementName=SearchTextBox}"
        Width="620"
        Height="520"
        MinWidth="540"
        MinHeight="420"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner">
    <Border Margin="12"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Token.RadiusXl}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Add To Existing Mtab"
                       Style="{StaticResource Dialog.Title}" />

            <StackPanel Grid.Row="1"
                        Margin="0,10,0,12">
                <TextBlock x:Name="IncomingSummaryText"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,0,0,8" />
                <Grid>
                    <TextBox x:Name="SearchTextBox" MinHeight="32"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OnSearchTextChanged"
                             AutomationProperties.Name="Search Mtabs"
                             ToolTip="Search Mtab by name or path"
                             Margin="0" />
                    <TextBlock Text="Search Mtabs…"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Token.TextTertiaryBrush}"
                               Margin="10,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=SearchTextBox}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource Token.StatusDangerBrush}"
                           FontSize="{DynamicResource Token.TextSm}"
                           Visibility="Collapsed"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Border Background="{DynamicResource SurfaceElevated}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Token.RadiusLg}"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding Mtabs.Count, StringFormat=Available Mtabs: {0}}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,0,0,8" />

                        <ListBox x:Name="MtabListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding FilteredMtabs}"
                                 SelectedItem="{Binding SelectedMtab}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8"
                                            Margin="0,0,0,6"
                                            Background="{DynamicResource SurfaceBackground}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Token.RadiusLg}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplayPath}"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <TextBlock
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Text">
                                <Setter.Value>
                                    <Binding Path="SearchText" StringFormat="No Mtab matches '{0}'" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=MtabListBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mtabs.Count}" Value="0">
                                    <Setter Property="Text" Value="No existing Mtab found." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button IsCancel="True" Content="Cancel"
                        Style="{StaticResource Simple.Button}"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="OnCancel" />
                <Button IsDefault="True" Content="Add to Mtab"
                        Width="132"
                        Style="{StaticResource Simple.PrimaryButton}"
                        Click="OnConfirm" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
