<Window x:Class="MyList.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None"
        Background="{DynamicResource Token.BgSurfaceBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource Token.FontUi}"
        WindowStartupLocation="CenterOwner">
    <!-- Exact quick-menu corner: opaque window + native rounded HWND region
         (code-behind ApplyRoundedRegion) + 1px border + ClipToBounds, radius 50. -->
    <!-- Square fill; the native HWND region is the ONLY thing that rounds the
         corner, so there's no inner WPF curve sitting inside the region edge. -->
    <Border Width="400"
            Background="{DynamicResource Token.BgSurfaceBrush}"
            BorderThickness="0"
            CornerRadius="0">
        <Grid Margin="22,20,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <Border Width="30" Height="30"
                        Margin="0,0,12,0"
                        Background="{DynamicResource Token.StatusDangerBackgroundBrush}"
                        CornerRadius="{DynamicResource Token.RadiusFull}"
                        VerticalAlignment="Center">
                    <iconPacks:PackIconLucide Kind="Trash2"
                                              Width="15" Height="15"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource Token.StatusDangerBrush}" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Text="Confirm"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Token.TextLg}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Token.TextPrimaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource Token.TextMd}"
                       LineHeight="19"
                       Foreground="{DynamicResource Token.TextSecondaryBrush}" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="84"
                        Height="32"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="OnCancel">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{DynamicResource Token.BgSubtleBrush}"
                                    BorderBrush="{DynamicResource Token.BorderDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Token.RadiusMd}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Token.BgMutedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <DynamicResource ResourceKey="Token.TextPrimaryBrush" />
                    </Button.Foreground>
                </Button>

                <Button x:Name="ConfirmButton"
                        Content="Delete"
                        MinWidth="84"
                        Height="32"
                        Cursor="Hand"
                        IsDefault="True"
                        Foreground="{DynamicResource Token.AccentForegroundBrush}"
                        Click="OnConfirm">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{DynamicResource Token.StatusDangerBrush}"
                                    CornerRadius="{DynamicResource Token.RadiusMd}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
