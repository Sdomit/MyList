<UserControl x:Class="MyList.Views.ItemEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Token.TransparentBrush}"
             Foreground="{DynamicResource Token.TextPrimaryBrush}"
             FontFamily="{DynamicResource Token.FontUi}">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Simple.Button}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource Simple.TextBox}" />
        <Style x:Key="EditorFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Token.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="EditorSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Simple.SectionLabel}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="20,18,20,14"
                BorderBrush="{DynamicResource Token.BorderHairBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Simple.PaneTitle}" Text="Item editor" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Simple.MetaText}"
                               Text="Edit identity, launch behavior, and tags." />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="7,3"
                        Background="{DynamicResource Token.AccentSoftBrush}"
                        BorderBrush="{DynamicResource Token.AccentMuteBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Token.RadiusXs}"
                        VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource Simple.MonoText}"
                               Foreground="{DynamicResource Token.TextAccentBrush}"
                               Text="{Binding Type}" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,22">
                <TextBlock Style="{StaticResource EditorSectionLabel}" Text="IDENTITY" />

                <TextBlock Style="{StaticResource EditorFieldLabel}" Text="Name" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,12,0,6" Style="{StaticResource EditorFieldLabel}" Text="Path" />
                <TextBox FontFamily="{DynamicResource Token.FontMono}"
                         FontSize="12"
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EditorFieldLabel}" Text="Type" />
                        <ComboBox ItemsSource="{Binding ItemTypes}"
                                  SelectedItem="{Binding Type}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource EditorFieldLabel}" Text="Tags" />
                        <TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,12,0,6" Style="{StaticResource EditorFieldLabel}" Text="Icon override path" />
                <TextBox FontFamily="{DynamicResource Token.FontMono}"
                         FontSize="12"
                         Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                    <CheckBox Content="Use system icon"
                              IsChecked="{Binding UseSystemIcon}" />
                    <CheckBox Content="Favorite"
                              Margin="18,0,0,0"
                              IsChecked="{Binding IsFavorite}" />
                </StackPanel>

                <Border Height="1"
                        Margin="0,0,0,18"
                        Background="{DynamicResource Token.BorderHairBrush}" />

                <TextBlock Style="{StaticResource EditorSectionLabel}" Text="LAUNCH" />

                <TextBlock Style="{StaticResource EditorFieldLabel}" Text="Arguments" />
                <TextBox FontFamily="{DynamicResource Token.FontMono}"
                         FontSize="12"
                         Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,12,0,6" Style="{StaticResource EditorFieldLabel}" Text="Working directory" />
                <TextBox FontFamily="{DynamicResource Token.FontMono}"
                         FontSize="12"
                         Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EditorFieldLabel}" Text="Terminal profile" />
                        <ComboBox ItemsSource="{Binding TerminalProfiles}"
                                  SelectedItem="{Binding TerminalProfile}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox Content="Run as administrator"
                                  IsChecked="{Binding RunAsAdmin}" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,20,0,0"
                        Padding="12"
                        Background="{DynamicResource Token.BgSubtleBrush}"
                        BorderBrush="{DynamicResource Token.BorderHairBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Token.RadiusLg}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="9"
                                 Height="9"
                                 VerticalAlignment="Top"
                                 Margin="0,3,0,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Token.StatusOkBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Item.IsOffline}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Token.StatusWarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock FontSize="12.5"
                                       FontWeight="Medium"
                                       Text="Path health" />
                            <TextBlock Margin="0,3,0,0"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Simple.MetaText}">
                                        <Setter Property="Text" Value="Available and ready to open." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Item.IsOffline}" Value="True">
                                                <Setter Property="Text" Value="Offline or unavailable. Save is still allowed." />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="16,12"
                Background="{DynamicResource Token.BgMicaBrush}"
                BorderBrush="{DynamicResource Token.BorderHairBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="90"
                        Style="{StaticResource Simple.GhostButton}"
                        Command="{Binding CancelCommand}" />
                <Button Content="Save changes"
                        Width="112"
                        Margin="8,0,0,0"
                        Style="{StaticResource Simple.PrimaryButton}"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
