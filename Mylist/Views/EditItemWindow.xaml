<Window x:Class="MyList.Views.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Item" Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Name" Margin="0,0,0,4" />
        <TextBox Grid.Row="1" Text="{Binding Name}" />

        <TextBlock Grid.Row="2" Text="Path" Margin="0,12,0,4" />
        <TextBox Grid.Row="3" Text="{Binding Path}" />

        <TextBlock Grid.Row="4" Text="Type" Margin="0,12,0,4" />
        <ComboBox Grid.Row="5" ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding Type}" />

        <TextBlock Grid.Row="6" Text="Icon override path" Margin="0,12,0,4" />
        <TextBox Grid.Row="7" Text="{Binding IconPath}" />

        <CheckBox Grid.Row="8" Content="Use system icon" Margin="0,10,0,0" IsChecked="{Binding UseSystemIcon}" />

        <TextBlock Grid.Row="9" Text="Tags (comma separated)" Margin="0,12,0,4" />
        <TextBox Grid.Row="10" Text="{Binding Tags}" />

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="Save" Width="80" Style="{StaticResource Simple.PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
