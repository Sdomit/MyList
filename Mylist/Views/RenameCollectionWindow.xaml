<Window x:Class="MyList.Views.RenameCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        MinWidth="420"
        SizeToContent="Height"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border Margin="12"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Token.RadiusXl}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="20"
                       FontWeight="SemiBold" />

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="Collection name"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBox Text="{Binding CollectionName}" />
            </StackPanel>

            <CheckBox Grid.Row="2"
                      Content="Smart collection"
                      Margin="0,14,0,0"
                      IsChecked="{Binding IsSmart}" />

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSmart}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Smart filter"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource TextSecondary}" />
                <ComboBox ItemsSource="{Binding SmartTypes}" SelectedItem="{Binding SmartType}" />
                <TextBlock Text="Tag name or days"
                           Margin="0,12,0,6"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBox Text="{Binding SmartValue}" />
            </StackPanel>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Content="Cancel"
                        Style="{StaticResource Simple.Button}"
                        MinWidth="96"
                        MinHeight="34"
                        Margin="0,0,8,0"
                        Click="OnCancel" />
                <Button Content="Save"
                        Style="{StaticResource Simple.PrimaryButton}"
                        MinWidth="96"
                        MinHeight="34"
                        Margin="0"
                        Click="OnSave" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
