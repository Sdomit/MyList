<Window x:Class="MyList.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MyList.Converters"
        xmlns:helpers="clr-namespace:MyList.Helpers"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:views="clr-namespace:MyList.Views"
        Title="MyList"
        Icon="pack://siteoforigin:,,,/desktops.png"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Token.BgMicaBrush}"
        Foreground="{DynamicResource Token.TextPrimaryBrush}"
        FontFamily="{DynamicResource Token.FontUi}"
        FontSize="13"
        AllowDrop="True"
        Drop="OnDrop"
        PreviewDragOver="OnPreviewDragOver"
        KeyDown="OnWindowKeyDown"
        Topmost="{Binding Settings.AlwaysOnTop}">
    <Window.InputBindings>
        <KeyBinding Key="N"
                    Modifiers="Control"
                    Command="{Binding OpenInlineAddCommand}" />
        <KeyBinding Key="V"
                    Modifiers="Control+Shift"
                    Command="{Binding OpenClipboardReviewPaneCommand}" />
        <KeyBinding Key="D"
                    Modifiers="Control"
                    Command="{Binding OpenDuplicateManagerPaneCommand}" />
        <!-- Index hotkeys: Ctrl+1..9 open the first 9 visible non-separator items
             in the current collection. Mirrors the kbd chip rendered on each row. -->
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="6" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="7" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="8" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="9" />
    </Window.InputBindings>
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Invert="True" />
        <helpers:IntPlusOneConverter x:Key="IntPlusOneConverter" />
        <helpers:PercentToDashArrayConverter x:Key="PercentToDashArrayConverter" />
        <helpers:HealthStateToBrushConverter x:Key="HealthStateToBrushConverter" />
        <helpers:HealthStateToIsDashedConverter x:Key="HealthStateToIsDashedConverter" />
        <helpers:TrajectoryBarTooltipConverter x:Key="TrajectoryBarTooltipConverter" />
        <helpers:TrendDeltaToHealthBrushConverter x:Key="TrendDeltaToHealthBrushConverter" />
        <helpers:TrendDeltaToLucideKindConverter x:Key="TrendDeltaToLucideKindConverter" />

        <Style x:Key="Constellation.Row" TargetType="Button" BasedOn="{StaticResource Simple.GhostButton}">
            <Setter Property="Height" Value="30" />
            <!-- Padding-left matches Constellation.Eyebrow / SubEyebrow Margin-left (12) so
                 item icons sit under the section header text instead of 2px to the left. -->
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Constellation.Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Token.FontMono}" />
            <Setter Property="FontSize" Value="{StaticResource Token.TextXs}" />
            <Setter Property="FontWeight" Value="{StaticResource Token.WeightMedium}" />
            <Setter Property="Foreground" Value="{DynamicResource Token.TextTertiaryBrush}" />
            <Setter Property="Margin" Value="12,0,12,8" />
        </Style>

        <Style x:Key="Constellation.SubEyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Token.TextSm}" />
            <Setter Property="Foreground" Value="{DynamicResource Token.TextSecondaryBrush}" />
            <Setter Property="Margin" Value="12,0,12,4" />
        </Style>

        <DataTemplate x:Key="CollectionTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconLucide Kind="Folder"
                                          Width="13"
                                          Height="13"
                                          Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                          VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="9,0,8,0"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Style="{StaticResource Simple.MonoText}"
                           Text="{Binding Items.Count}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ListItemTemplate">
            <Grid>
                <Border x:Name="ItemContent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon cell: 24x24 stack of health-track + score arc + type-colored glyph (HANDOFF §3.3) -->
                        <Grid Width="24"
                              Height="24"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Ellipse Width="22"
                                     Height="22"
                                     Stroke="{DynamicResource Token.BgHoverBrush}"
                                     StrokeThickness="1.5"
                                     SnapsToDevicePixels="False" />
                            <Ellipse x:Name="HealthArc"
                                     Width="22"
                                     Height="22"
                                     Stroke="{Binding HealthState, Converter={StaticResource HealthStateToBrushConverter}}"
                                     StrokeThickness="1.5"
                                     StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="StrokeDashArray" Value="{Binding HealthScore, Converter={StaticResource PercentToDashArrayConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HealthState, Converter={StaticResource HealthStateToIsDashedConverter}}" Value="True">
                                                <Setter Property="StrokeDashArray" Value="4 3" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Border Width="14"
                                    Height="14"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Token.RadiusSm}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Token.TypeFileBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeFileBorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Folder">
                                                <Setter Property="Background" Value="{DynamicResource Token.TypeFolderBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeFolderBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMtab}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Token.TypeMtabBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeMtabBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsClipboardText}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Token.TypeClipBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeClipBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsClipboardImage}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Token.TypeClipBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeClipBorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActionItem}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Token.TypeActionBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeActionBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Width="10"
                                       Height="10"
                                       Source="{Binding Icon}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,12,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource Token.TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource Simple.MonoText}"
                                       Text="{Binding DisplayPath}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Sparkline: 14-day access trajectory polyline (HANDOFF §3.2) -->
                        <Polyline Grid.Column="2"
                                  Width="60"
                                  Height="16"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Points="{Binding TrajectoryPoints}"
                                  Stroke="{DynamicResource Token.AccentBrush}"
                                  StrokeThickness="1.5"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0.7" />

                        <!-- Kbd chip: hidden, fades in on row hover or selection (120ms, EaseStandard).
                             Chrome via Chip.Kbd (Themes/Chips.xaml); fade + visibility stay here. -->
                        <ContentControl x:Name="KbdChip"
                                        Grid.Column="3"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding Path=(ItemsControl.AlternationIndex),
                                                             RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                             Converter={StaticResource IntPlusOneConverter}}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource Chip.Kbd}">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.12">
                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="1" KeySpline="{StaticResource Token.EaseStandard}" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.12">
                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="0" KeySpline="{StaticResource Token.EaseStandard}" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.12">
                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="1" KeySpline="{StaticResource Token.EaseStandard}" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.12">
                                                            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="0" KeySpline="{StaticResource Token.EaseStandard}" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Token.BorderDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock><Run Text="Ctrl+" /><Run Text="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource IntPlusOneConverter}, Mode=OneWay}" /></TextBlock>
                        </ContentControl>
                    </Grid>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open"
                                      Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.OpenItemCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Open in new window"
                                      Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.OpenNewWindowCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Open in Terminal here"
                                      Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.OpenInTerminalCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.TogglePinCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="Pin to Constellation" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Item.IsPinned, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                <Setter Property="Header" Value="Unpin from Constellation" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Copy"
                                      Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.CopyPathCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Retry health check"
                                      Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.RetryHealthCheckCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Edit"
                                      Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.EditItemCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Edit Mtab..."
                                      Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.EditMtabCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PlacementTarget.DataContext.Item.IsMtab, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Remove from Collection"
                                      Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.RemoveItemFromCurrentCollectionCommand}">
                                <MenuItem.CommandParameter>
                                    <MultiBinding Converter="{StaticResource ItemCollectionActionContextConverter}">
                                        <Binding RelativeSource="{RelativeSource AncestorType=ContextMenu}" Path="PlacementTarget.DataContext.Item" />
                                        <Binding RelativeSource="{RelativeSource AncestorType=ContextMenu}" Path="PlacementTarget.Tag" />
                                    </MultiBinding>
                                </MenuItem.CommandParameter>
                            </MenuItem>
                            <MenuItem Header="Delete Globally"
                                      Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.DeleteItemGloballyCommand}"
                                      CommandParameter="{Binding PlacementTarget.DataContext.Item, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                </Border>

                <Border x:Name="SeparatorRow"
                        Visibility="Collapsed"
                        Padding="0,8">
                    <Border Height="1"
                            Background="{DynamicResource Token.BorderSubtleBrush}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter TargetName="ItemContent" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="SeparatorRow" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="GridItemTemplate">
            <Border Margin="3"
                    Padding="10,9"
                    Background="{DynamicResource Token.BgSurfaceBrush}"
                    BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Token.RadiusLg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Token.RadiusSm}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Token.TypeFileBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeFileBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Folder">
                                        <Setter Property="Background" Value="{DynamicResource Token.TypeFolderBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeFolderBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMtab}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Token.TypeMtabBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeMtabBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsClipboardText}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Token.TypeClipBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeClipBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsClipboardImage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Token.TypeClipBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeClipBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActionItem}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Token.TypeActionBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Token.TypeActionBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Width="13"
                               Height="13"
                               Source="{Binding Icon}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding Name}"
                               Foreground="{DynamicResource Token.TextPrimaryBrush}"
                               FontSize="{StaticResource Token.TextSm}"
                               FontWeight="{StaticResource Token.WeightMedium}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DisplayPath}" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="PreviewVisibilityWhenSelected" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PreviewVisibilityWhenEmpty" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Token.BgMicaBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{DynamicResource Token.Grid.TitleBar}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{DynamicResource Token.Grid.StatusBar}" />
        </Grid.RowDefinitions>

        <!-- Quiet title bar -->
        <Grid Grid.Row="0" Margin="14,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="16"
                        Height="16"
                        Background="{DynamicResource Token.AccentBrush}"
                        CornerRadius="{DynamicResource Token.RadiusSm}">
                    <!-- Brand badge — intentional inline geometry; no Lucide equivalent. -->
                    <Path Data="M3,4 L8,12 L13,4 M3,12 L13,12"
                          Stroke="{DynamicResource Token.AccentForegroundBrush}"
                          StrokeThickness="1.5"
                          Stretch="Uniform"
                          Margin="3" />
                </Border>
                <TextBlock Margin="8,0,0,0"
                           Text="MyList"
                           FontSize="12"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1"
                    MaxWidth="520"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Token.BgSurfaceBrush}"
                    BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Token.RadiusFull}">
                <Grid Margin="13,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconLucide Kind="Search"
                                              Width="13"
                                              Height="13"
                                              Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                              VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Height="24"
                             Margin="7,0,4,0"
                             Padding="0"
                             Background="{DynamicResource Token.TransparentBrush}"
                             BorderThickness="0"
                             FontSize="12.5"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1"
                               Margin="7,0,4,0"
                               Foreground="{DynamicResource Token.TextTertiaryBrush}"
                               FontSize="12.5"
                               Text="Search items, tags, or paths"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="2"
                            Padding="7,1"
                            Background="{DynamicResource Token.BgSubtleBrush}"
                            BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Token.RadiusFull}"
                            VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Simple.MonoText}" Text="Ctrl+K" FontSize="10" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource Simple.GhostButton}"
                        Margin="0,0,6,0"
                        MinWidth="28"
                        Padding="0"
                        Command="{Binding ToggleViewModeCommand}"
                        ToolTip="Toggle list / grid view">
                    <Grid>
                        <iconPacks:PackIconLucide Kind="LayoutGrid" Width="14" Height="14">
                            <iconPacks:PackIconLucide.Style>
                                <Style TargetType="iconPacks:PackIconLucide">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.ViewMode}" Value="List">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconLucide.Style>
                        </iconPacks:PackIconLucide>
                        <iconPacks:PackIconLucide Kind="List" Width="14" Height="14">
                            <iconPacks:PackIconLucide.Style>
                                <Style TargetType="iconPacks:PackIconLucide">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.ViewMode}" Value="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconLucide.Style>
                        </iconPacks:PackIconLucide>
                    </Grid>
                </Button>
                <Button Style="{StaticResource Simple.PrimaryButton}"
                        Content="Add"
                        Margin="0,0,4,0"
                        Click="OnMoreActionsClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="File..." Command="{Binding PlacementTarget.DataContext.AddFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Folder..." Command="{Binding PlacementTarget.DataContext.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Mtab" Command="{Binding PlacementTarget.DataContext.NewMtabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Action / script" Command="{Binding PlacementTarget.DataContext.NewActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Clipboard" Command="{Binding PlacementTarget.DataContext.OpenClipboardReviewPaneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Simple main surface -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource Token.Grid.Sidebar}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{DynamicResource Token.Grid.Preview}" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Grid.Column="0" Margin="12,8,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="10,4,6,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Simple.SectionLabel}"
                                       Text="COLLECTIONS"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Width="18"
                                    Height="18"
                                    MinWidth="18"
                                    Padding="0"
                                    Style="{StaticResource Simple.GhostButton}"
                                    Command="{Binding AddCollectionCommand}">
                                <iconPacks:PackIconLucide Kind="Plus"
                                                          Width="10"
                                                          Height="10"
                                                          Foreground="{DynamicResource Token.TextTertiaryBrush}" />
                            </Button>
                        </Grid>

                        <ListBox ItemsSource="{Binding Collections}"
                                 SelectedItem="{Binding SelectedCollection}"
                                 ItemTemplate="{StaticResource CollectionTemplate}"
                                 PreviewMouseLeftButtonDown="OnCollectionPreviewMouseLeftButtonDown"
                                 PreviewMouseMove="OnCollectionPreviewMouseMove"
                                 Drop="OnCollectionDrop"
                                 AllowDrop="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Simple.NavListBoxItem}">
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Open all"
                                                          Command="{Binding PlacementTarget.Tag.OpenAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Rename"
                                                          Command="{Binding PlacementTarget.Tag.RenameCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Delete"
                                                          Command="{Binding PlacementTarget.Tag.DeleteCollectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <TextBlock Margin="10,16,6,3"
                                   Style="{StaticResource Simple.SectionLabel}"
                                   Text="TOOLS" />
                        <Button Style="{StaticResource Simple.NavButton}"
                                Command="{Binding OpenClipboardReviewPaneCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MaxWidth="110" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconLucide Kind="Clipboard"
                                                          Width="13"
                                                          Height="13"
                                                          Foreground="{DynamicResource Token.TextTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Margin="9,0,6,0" Text="Clipboard" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Simple.MonoText}" Text="Ctrl+Shift+V" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Simple.NavButton}"
                                Command="{Binding OpenDuplicateManagerPaneCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconLucide Kind="Layers"
                                                          Width="13"
                                                          Height="13"
                                                          Foreground="{DynamicResource Token.TextTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="Duplicates" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Simple.MonoText}" Text="Ctrl+D" />
                            </Grid>
                        </Button>

                        <!-- Constellation group (HANDOFF §4) -->
                        <Border Height="1"
                                Margin="12,12"
                                Background="{DynamicResource Token.BorderSubtleBrush}" />

                        <TextBlock Text="CONSTELLATION"
                                   Style="{StaticResource Constellation.Eyebrow}" />

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PinnedItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Pinned" Style="{StaticResource Constellation.SubEyebrow}" />
                            <ItemsControl ItemsSource="{Binding PinnedItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Constellation.Row}"
                                                Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.OpenItemCommand}"
                                                CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open"
                                                              Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.OpenItemCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Unpin"
                                                              Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.TogglePinCommand}"
                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconLucide Kind="Pin"
                                                                          Width="14"
                                                                          Height="14"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="9,0,0,0"
                                                           Text="{Binding Name}"
                                                           FontSize="{StaticResource Token.TextSm}"
                                                           Foreground="{DynamicResource Token.TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RecentItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Recent" Style="{StaticResource Constellation.SubEyebrow}" />
                            <ItemsControl ItemsSource="{Binding RecentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Constellation.Row}"
                                                Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.OpenItemCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconLucide Kind="Clock"
                                                                          Width="14"
                                                                          Height="14"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="9,0,0,0"
                                                           Text="{Binding Name}"
                                                           FontSize="{StaticResource Token.TextSm}"
                                                           Foreground="{DynamicResource Token.TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Margin="0,8,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TrendingItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Trending" Style="{StaticResource Constellation.SubEyebrow}" />
                            <ItemsControl ItemsSource="{Binding TrendingItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Constellation.Row}"
                                                Command="{Binding Source={x:Reference RootWindow}, Path=DataContext.OpenItemCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconLucide Kind="TrendingUp"
                                                                          Width="14"
                                                                          Height="14"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="9,0,6,0"
                                                           Text="{Binding Name}"
                                                           FontSize="{StaticResource Token.TextSm}"
                                                           Foreground="{DynamicResource Token.TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="2"
                                                        Width="20"
                                                        Height="16"
                                                        CornerRadius="{StaticResource Token.RadiusXs}"
                                                        Background="{Binding TrendDelta, Converter={StaticResource TrendDeltaToHealthBrushConverter}}"
                                                        VerticalAlignment="Center">
                                                    <iconPacks:PackIconLucide Kind="{Binding TrendDelta, Converter={StaticResource TrendDeltaToLucideKindConverter}}"
                                                                              Width="10"
                                                                              Height="10"
                                                                              Foreground="{DynamicResource Token.WhiteBrush}"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Margin="6,8,4,0"
                        Padding="6,8,0,2"
                        BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24"
                                Height="24"
                                Background="{DynamicResource Token.AccentBrush}"
                                CornerRadius="{DynamicResource Token.RadiusFull}">
                            <TextBlock Text="ML"
                                       Foreground="{DynamicResource Token.AccentForegroundBrush}"
                                       FontSize="{StaticResource Token.TextXs}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,4,0">
                            <TextBlock Text="MyList" FontSize="{DynamicResource Token.TextXs}" />
                            <TextBlock Style="{StaticResource Simple.MonoText}"
                                       Text="{Binding AllItems.Count, StringFormat={}{0} items}" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource Simple.IconButton}"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip="Settings">
                            <iconPacks:PackIconLucide Kind="Settings"
                                                      Width="13"
                                                      Height="13"
                                                      Foreground="{DynamicResource Token.TextTertiaryBrush}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Items pane -->
            <Border Grid.Column="1"
                    Style="{StaticResource Simple.Pane}"
                    CornerRadius="10,10,0,0"
                    BorderThickness="1,0,1,0"
                    Visibility="{Binding IsCollectionPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="24,18,24,12"
                            BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Simple.PaneTitle}"
                                           Text="{Binding SelectedCollection.Name}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Style="{StaticResource Simple.MetaText}"
                                               Text="{Binding SelectedCollection.Items.Count, StringFormat={}{0} items}" />
                                    <Ellipse Width="2"
                                             Height="2"
                                             Fill="{DynamicResource Token.TextTertiaryBrush}"
                                             Margin="8,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchStatusText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SearchStatusText}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Style="{StaticResource Simple.MetaText}"
                                               Text="{Binding SearchStatusText}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Simple.GhostButton}"
                                    Content="Open all"
                                    Command="{Binding OpenAllCommand}"
                                    CommandParameter="{Binding SelectedCollection}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Margin="16,10,16,6"
                                Height="34"
                                HorizontalContentAlignment="Stretch"
                                Style="{StaticResource Simple.GhostButton}"
                                BorderBrush="{DynamicResource Token.BorderDefaultBrush}"
                                BorderThickness="1"
                                Visibility="{Binding IsAddFormOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                Click="OnInlineAddOpenClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource Token.RadiusMd}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Token.AccentSubtleBrush}" />
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Token.AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Add file..." Command="{Binding PlacementTarget.DataContext.AddFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Add folder..." Command="{Binding PlacementTarget.DataContext.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="New Mtab" Command="{Binding PlacementTarget.DataContext.NewMtabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="New action / script" Command="{Binding PlacementTarget.DataContext.NewActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Add from clipboard" Command="{Binding PlacementTarget.DataContext.OpenClipboardReviewPaneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="Add separator" Command="{Binding PlacementTarget.DataContext.AddSeparatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconLucide Kind="Plus"
                                                          Width="11"
                                                          Height="11"
                                                          Foreground="{DynamicResource Token.TextTertiaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                           Text="Add item..." />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource Simple.MonoText}"
                                           Text="drop a file, paste a path, or click here"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="280" />
                            </Grid>
                        </Button>

                        <Border Margin="16,10,16,6"
                                Padding="8"
                                Background="{DynamicResource Token.BgSubtleBrush}"
                                BorderBrush="{DynamicResource Token.AccentMutedBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Token.RadiusMd}"
                                Visibility="{Binding IsAddFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InlineAddBox"
                                         Margin="0,0,6,0"
                                         Text="{Binding InlineAddValue, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Paste or type a rooted file, folder, or UNC path"
                                         KeyDown="OnInlineAddKeyDown" />
                                <Button Grid.Column="1"
                                        Content="File..."
                                        Style="{StaticResource Simple.GhostButton}"
                                        Command="{Binding AddFileCommand}" />
                                <Button Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Content="Folder..."
                                        Style="{StaticResource Simple.GhostButton}"
                                        Command="{Binding AddFolderCommand}" />
                                <Button Grid.Column="3"
                                        Margin="4,0,0,0"
                                        Content="Mtab"
                                        Style="{StaticResource Simple.GhostButton}"
                                        Command="{Binding NewMtabCommand}" />
                                <Button Grid.Column="4"
                                        Margin="6,0,0,0"
                                        Content="Add"
                                        Style="{StaticResource Simple.PrimaryButton}"
                                        Command="{Binding SaveInlineAddCommand}" />
                                <Button Grid.Column="5"
                                        Margin="4,0,0,0"
                                        Content="Cancel"
                                        Style="{StaticResource Simple.GhostButton}"
                                        Command="{Binding CancelInlineAddCommand}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="16,0,16,6"
                                Padding="10"
                                Background="{DynamicResource Token.BgSubtleBrush}"
                                BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Token.RadiusLg}"
                                Visibility="{Binding IsQuickEditOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding QuickEditName}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Text="{Binding QuickEditPath}" Margin="0,0,6,0" />
                                <TextBox Grid.Column="2" Text="{Binding QuickEditTags}" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="Cancel" Style="{StaticResource Simple.GhostButton}" Command="{Binding CancelQuickEditCommand}" />
                                    <Button Content="Save" Margin="4,0,0,0" Style="{StaticResource Simple.PrimaryButton}" Command="{Binding SaveQuickEditCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="16,0,16,6"
                                Padding="8"
                                Background="{DynamicResource Token.AccentSubtleBrush}"
                                CornerRadius="{DynamicResource Token.RadiusMd}"
                                Visibility="{Binding IsBulkToolbarVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="4,0,12,0"
                                               Text="{Binding SelectedItems.Count, StringFormat={}{0} selected}"
                                               VerticalAlignment="Center" />
                                    <Button Content="Open" Style="{StaticResource Simple.GhostButton}" Command="{Binding OpenSelectedCommand}" />
                                    <Button Content="Remove here" Style="{StaticResource Simple.GhostButton}" Command="{Binding RemoveSelectedFromCurrentCollectionCommand}" />
                                    <Button Content="Delete" Style="{StaticResource Simple.GhostButton}" Command="{Binding DeleteSelectedGloballyCommand}" />
                                    <Button Content="Favorite" Style="{StaticResource Simple.GhostButton}" Command="{Binding ToggleFavoriteSelectedCommand}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="3">
                            <ListBox x:Name="ListItems"
                                     Margin="6,0,4,18"
                                     Padding="10,0"
                                     ItemsSource="{Binding SelectedCollection.FilteredEntries}"
                                     Tag="{Binding SelectedCollection}"
                                     SelectionMode="Extended"
                                     SelectionChanged="OnItemSelectionChanged"
                                     ItemContainerStyle="{StaticResource Simple.ItemListBoxItem}"
                                     AlternationCount="9999"
                                     MouseDoubleClick="OnItemMouseDoubleClick"
                                     PreviewMouseLeftButtonDown="OnItemPreviewMouseLeftButtonDown"
                                     PreviewMouseMove="OnItemPreviewMouseMove"
                                     Drop="OnItemDrop"
                                     AllowDrop="True">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="ItemTemplate" Value="{StaticResource ListItemTemplate}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.ViewMode}" Value="Grid">
                                                <Setter Property="ItemTemplate" Value="{StaticResource GridItemTemplate}" />
                                                <Setter Property="ItemsPanel">
                                                    <Setter.Value>
                                                        <ItemsPanelTemplate>
                                                            <!-- Top-aligned so the grid sizes to its cards; otherwise the
                                                                 viewport height is split across rows and a single row of
                                                                 cards stretches to fill the whole list. -->
                                                            <UniformGrid Columns="2" VerticalAlignment="Top" />
                                                        </ItemsPanelTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                            </ListBox>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="300"
                                        Visibility="{Binding SelectedCollection.FilteredEntries.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Nothing here yet"
                                           FontSize="{DynamicResource Token.TextBase}"
                                           FontWeight="Medium"
                                           TextAlignment="Center" />
                                <TextBlock Margin="0,5,0,14"
                                           Style="{StaticResource Simple.MetaText}"
                                           Text="Drop a file, paste a path, or use the add row above."
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <Button Content="Add folder"
                                        Width="110"
                                        Style="{StaticResource Simple.PrimaryButton}"
                                        Command="{Binding AddFolderCommand}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Preview pane -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Token.BgSurfaceBrush}"
                    CornerRadius="10,10,0,0"
                    Visibility="{Binding IsCollectionPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid Style="{StaticResource PreviewVisibilityWhenEmpty}">
                        <StackPanel Margin="18,18">
                            <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="NO SELECTION" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource Simple.PaneTitle}"
                                       Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                       Text="Pick an item" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Simple.MetaText}"
                                       Text="Select a row to inspect its details."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Grid Style="{StaticResource PreviewVisibilityWhenSelected}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Padding="18,16,18,12"
                                BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="{Binding SelectedItem.Type}" />
                                    <Button HorizontalAlignment="Right"
                                            Style="{StaticResource Simple.IconButton}"
                                            Click="OnClearSelectionClick">
                                        <iconPacks:PackIconLucide Kind="X"
                                                                  Width="11"
                                                                  Height="11"
                                                                  Foreground="{DynamicResource Token.TextTertiaryBrush}" />
                                    </Button>
                                </Grid>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource Simple.PaneTitle}"
                                           Text="{Binding SelectedItem.Name}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Simple.MonoText}"
                                           Text="{Binding SelectedItem.DisplayPath}"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource Simple.PrimaryButton}"
                                            Command="{Binding OpenItemCommand}"
                                            CommandParameter="{Binding SelectedItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="ExternalLink"
                                                                      Width="11"
                                                                      Height="11"
                                                                      Foreground="{DynamicResource Token.AccentForegroundBrush}" />
                                            <TextBlock Margin="6,0,0,0" Text="Open" Foreground="{DynamicResource Token.AccentForegroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="6,0,0,0"
                                            Command="{Binding EditItemCommand}"
                                            CommandParameter="{Binding SelectedItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Pencil"
                                                                      Width="11"
                                                                      Height="11"
                                                                      Foreground="{DynamicResource Token.TextPrimaryBrush}" />
                                            <TextBlock Margin="6,0,0,0" Text="Edit" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="6,0,0,0"
                                            Style="{StaticResource Simple.IconButton}"
                                            Command="{Binding CopyPathCommand}"
                                            CommandParameter="{Binding SelectedItem}"
                                            ToolTip="Copy">
                                        <iconPacks:PackIconLucide Kind="Copy"
                                                                  Width="12"
                                                                  Height="12"
                                                                  Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="18,16,18,24">
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.IsMtab}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="FOLDERS" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding InlineMtabPaths}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="20"
                                                            Height="20"
                                                            Background="{DynamicResource Token.AccentSubtleBrush}"
                                                            CornerRadius="{DynamicResource Token.RadiusSm}">
                                                        <TextBlock Text="{Binding Number}"
                                                                   Foreground="{DynamicResource Token.TextAccentBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="1"
                                                            Margin="6,0,0,0"
                                                            Padding="6,3"
                                                            Background="{DynamicResource Token.BgSubtleBrush}"
                                                            BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{DynamicResource Token.RadiusMd}">
                                                        <TextBox Padding="2"
                                                                 Background="{DynamicResource Token.TransparentBrush}"
                                                                 BorderThickness="0"
                                                                 FontFamily="{DynamicResource Token.FontMono}"
                                                                 FontSize="11"
                                                                 Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Width="24"
                                                            Height="24"
                                                            MinWidth="24"
                                                            Margin="4,0,0,0"
                                                            Padding="0"
                                                            Content="x"
                                                            Style="{StaticResource Simple.GhostButton}"
                                                            Command="{Binding DataContext.RemoveInlineMtabPathCommand, ElementName=RootWindow}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Remove folder" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Add folder path"
                                                Style="{StaticResource Simple.GhostButton}"
                                                Command="{Binding AddInlineMtabPathCommand}" />
                                        <Button Grid.Column="1"
                                                Margin="4,0,0,0"
                                                Content="Reload"
                                                Style="{StaticResource Simple.GhostButton}"
                                                Command="{Binding ReloadInlineMtabCommand}" />
                                    </Grid>
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource Simple.MetaText}"
                                               Text="{Binding InlineMtabStatusText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,16,0,8"
                                               Style="{StaticResource Simple.SectionLabel}"
                                               Text="PREVIEW" />
                                    <Border Height="210"
                                            Background="{DynamicResource Token.BgSubtleBrush}"
                                            BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Token.RadiusMd}">
                                        <Canvas Width="260"
                                                Height="200"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ClipToBounds="False">
                                            <ItemsControl Width="260"
                                                          Height="200"
                                                          ItemsSource="{Binding InlineMtabPaths}"
                                                          IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Line X1="130"
                                                              Y1="100"
                                                              X2="{Binding LineX2}"
                                                              Y2="{Binding LineY2}"
                                                              Stroke="{DynamicResource Token.AccentBrush}"
                                                              StrokeThickness="1.5"
                                                              StrokeDashArray="3,3"
                                                              Opacity="0.4" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Ellipse Canvas.Left="125"
                                                     Canvas.Top="95"
                                                     Width="10"
                                                     Height="10"
                                                     Fill="{DynamicResource Token.AccentBrush}"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                                                 From="1"
                                                                                 To="1.08"
                                                                                 Duration="0:0:1.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <SineEase EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                                                 From="1"
                                                                                 To="1.08"
                                                                                 Duration="0:0:1.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <SineEase EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>

                                            <ItemsControl Width="260"
                                                          Height="200"
                                                          ItemsSource="{Binding InlineMtabPaths}"
                                                          IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding NodeLeft}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding NodeTop}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="80">
                                                            <Border Width="32"
                                                                    Height="32"
                                                                    HorizontalAlignment="Center"
                                                                    Background="{DynamicResource Token.BgSurfaceBrush}"
                                                                    BorderBrush="{DynamicResource Token.AccentBrush}"
                                                                    BorderThickness="1.5"
                                                                    CornerRadius="{DynamicResource Token.RadiusLg}">
                                                                <iconPacks:PackIconLucide Kind="Folder"
                                                                                          Width="16"
                                                                                          Height="16"
                                                                                          Foreground="{DynamicResource Token.TextAccentBrush}" />
                                                            </Border>
                                                            <Border Margin="0,4,0,0"
                                                                    Padding="4,2"
                                                                    Background="{DynamicResource Token.BgSurfaceBrush}"
                                                                    BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{DynamicResource Token.RadiusSm}">
                                                                <TextBlock Style="{StaticResource Simple.MonoText}"
                                                                           Text="{Binding Label}"
                                                                           TextAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </Border>
                                    <TextBlock Margin="0,7,0,0"
                                               Style="{StaticResource Simple.MonoText}"
                                               Text="{Binding InlineMtabPaths.Count, StringFormat={}{0} folders - opens as a tab group}"
                                               TextAlignment="Center" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Test open"
                                                Command="{Binding OpenItemCommand}"
                                                CommandParameter="{Binding SelectedItem}" />
                                        <Button Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Content="Save folders"
                                                Style="{StaticResource Simple.PrimaryButton}"
                                                Command="{Binding SaveInlineMtabCommand}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,18">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.IsMtab}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="DETAILS" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Simple.MetaText}" Text="Type" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Simple.MonoText}" Text="{Binding SelectedItem.Type}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource Simple.MetaText}" Text="Favorite" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource Simple.MonoText}" Text="{Binding SelectedItem.FavoriteDisplay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource Simple.MetaText}" Text="Last opened" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Style="{StaticResource Simple.MonoText}" Text="{Binding SelectedItem.LastOpenedDisplay}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="HEALTH" Margin="0,0,0,8" />
                                    <Border Padding="10,8"
                                            Background="{DynamicResource Token.BgSubtleBrush}"
                                            CornerRadius="{DynamicResource Token.RadiusMd}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9"
                                                     Height="9"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Token.StatusSuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem.HealthState}" Value="Offline">
                                                                <Setter Property="Fill" Value="{DynamicResource Token.StatusWarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedItem.HealthState}" Value="Missing">
                                                                <Setter Property="Fill" Value="{DynamicResource Token.StatusDangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedItem.HealthState}" Value="PermissionDenied">
                                                                <Setter Property="Fill" Value="{DynamicResource Token.StatusDangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding SelectedItem.HealthState}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="TRAJECTORY" Margin="0,0,0,8" />
                                    <Border Padding="10,8"
                                            Background="{DynamicResource Token.BgSubtleBrush}"
                                            CornerRadius="{DynamicResource Token.RadiusMd}"
                                            SnapsToDevicePixels="True"
                                            UseLayoutRounding="True">
                                        <Grid Height="52">
                                            <ItemsControl ItemsSource="{Binding SelectedItem.TrajectoryBars}"
                                                          HorizontalAlignment="Center">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem.OpenedHistory.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Bottom" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Width="6"
                                                                   Margin="1,0"
                                                                   VerticalAlignment="Bottom"
                                                                   Height="{Binding Height}"
                                                                   RadiusX="2"
                                                                   RadiusY="2"
                                                                   Fill="{DynamicResource Token.AccentBrush}"
                                                                   Opacity="{Binding Opacity}"
                                                                   SnapsToDevicePixels="True"
                                                                   ToolTip="{Binding Converter={StaticResource TrajectoryBarTooltipConverter}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No access history yet"
                                                       Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                                       FontSize="{StaticResource Token.TextXs}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem.OpenedHistory.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource Simple.SectionLabel}" Text="TAGS" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding SelectedItem.Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,5,5"
                                                        Padding="6,2"
                                                        Background="{DynamicResource Token.AccentSubtleBrush}"
                                                        BorderBrush="{DynamicResource Token.AccentMutedBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Token.RadiusXs}">
                                                    <TextBlock Style="{StaticResource Simple.MonoText}"
                                                               Foreground="{DynamicResource Token.TextAccentBrush}"
                                                               Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <views:ClipboardReviewView Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       Panel.ZIndex="5"
                                       Visibility="{Binding IsClipboardReviewPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <views:DuplicateManagerView Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Panel.ZIndex="5"
                                        Visibility="{Binding IsDuplicateManagerPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource Token.BgMicaBrush}"
                BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Token.StatusSuccessBrush}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Simple.MonoText}" Text="{Binding VisibleItemCount, StringFormat=Visible: {0}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Token.StatusWarningBrush}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Simple.MonoText}" Text="{Binding OfflineItemCount, StringFormat=Issues: {0}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Token.AccentBrush}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Simple.MonoText}" Text="{Binding FavoriteItemCount, StringFormat=Favorites: {0}}" />
                </StackPanel>
                <TextBlock Grid.Column="3"
                           Style="{StaticResource Simple.MonoText}"
                           Text="{Binding StatusText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Full settings view swap -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="30"
              Background="{DynamicResource Token.BgMicaBrush}"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="{DynamicResource Token.Grid.TitleBar}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="14,0,10,0">
                <Button Style="{StaticResource Simple.GhostButton}"
                        HorizontalAlignment="Left"
                        Command="{Binding CloseSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconLucide Kind="ArrowLeft"
                                                  Width="13"
                                                  Height="13"
                                                  Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                        <TextBlock Margin="8,0,0,0" Text="Back to MyList" />
                    </StackPanel>
                </Button>
            </Grid>
            <views:SettingsView Grid.Row="1" DataContext="{Binding Settings}" />
        </Grid>

        <!-- Item editor overlay -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="35"
              Visibility="{Binding Editor.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Background="{DynamicResource Token.OverlayBrush}"
                    BorderThickness="0"
                    Command="{Binding Editor.CancelCommand}" />
            <Border Width="420"
                    Margin="0,12,12,12"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource Token.BgSurfaceBrush}"
                    BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Token.Radius2Xl}"
                    Effect="{DynamicResource Token.ShadowLg}">
                <views:ItemEditorView DataContext="{Binding Editor}" />
            </Border>
        </Grid>

        <Border x:Name="DragDeleteHintHost"
                Grid.RowSpan="3"
                Panel.ZIndex="40"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,54"
                Background="{DynamicResource Token.BgSurfaceBrush}"
                BorderBrush="{DynamicResource Token.BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Token.Radius2Xl}"
                Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DragDeleteHintIcon"
                           Text="Drag"
                           Margin="0,0,8,0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Token.AccentBrush}" />
                <TextBlock x:Name="DragDeleteHintText"
                           Text="Drag outside window to delete"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Token.TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <Popup x:Name="PathCopyToast"
               AllowsTransparency="True"
               Focusable="False"
               IsHitTestVisible="False"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Background="{DynamicResource Token.BgSurfaceBrush}"
                    BorderBrush="{DynamicResource Token.AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Token.RadiusXl}"
                    Padding="12,7"
                    Effect="{DynamicResource Token.ShadowMd}">
                <TextBlock Text="Path copied"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Token.TextPrimaryBrush}" />
            </Border>
        </Popup>

        <!-- App-wide transient toast: bound to MainViewModel.ToastText, auto-clears after ~2.4s.
             Fades in/out via Opacity Storyboard on DataTrigger; IsHitTestVisible=False so it never blocks. -->
        <Border x:Name="ToastHost"
                Grid.RowSpan="3"
                Panel.ZIndex="50"
                IsHitTestVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Background="{DynamicResource Token.BgSurfaceBrush}"
                BorderBrush="{DynamicResource Token.BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Token.RadiusXl}"
                Padding="14,9"
                Effect="{DynamicResource Token.ShadowMd}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastText}" Value="{x:Null}">
                            <!-- Collapse outright: the fade-in EventTrigger fires on the initial
                                 (null) binding too, which otherwise leaves an empty capsule
                                 floating over every view. -->
                            <Setter Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <TextBlock Text="{Binding ToastText, NotifyOnTargetUpdated=True}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Token.TextPrimaryBrush}" />
        </Border>
    </Grid>
</Window>
