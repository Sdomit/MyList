<Window x:Class="MyList.Views.MiniLauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyList.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:helpers="clr-namespace:MyList.Helpers"
        Title="MyList Quick Launcher"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <helpers:KindToLucideKindConverter x:Key="KindToLucideKindConverter" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="6" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="7" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="8" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding OpenIndexedItemCommand}" CommandParameter="9" />
    </Window.InputBindings>

    <Border Width="520"
            Background="{DynamicResource Token.BgSurfaceBrush}"
            BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Token.Radius2Xl}"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Color="#000000" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top: search bar + Esc badge -->
            <Border Grid.Row="0"
                    Padding="16,14,16,12"
                    BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconLucide Kind="Search"
                                              Width="14"
                                              Height="14"
                                              Margin="0,0,10,0"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource Token.TextTertiaryBrush}" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="{DynamicResource Token.FontUi}"
                                 FontSize="{StaticResource Token.TextBase}"
                                 Foreground="{DynamicResource Token.TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource Token.AccentBrush}"
                                 VerticalAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock IsHitTestVisible="False"
                                   Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                   FontSize="{StaticResource Token.TextBase}"
                                   VerticalAlignment="Center"
                                   Text="Quick launch — search or pick a slot">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Column="2"
                            Padding="6,2"
                            Background="{DynamicResource Token.BgSubtleBrush}"
                            BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Token.RadiusXs}"
                            VerticalAlignment="Center">
                        <TextBlock Text="Esc"
                                   FontFamily="{DynamicResource Token.FontMono}"
                                   FontSize="{StaticResource Token.TextXs}"
                                   Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Orbit: 240x200 decorative panel with center badge + satellite nodes -->
            <Grid Grid.Row="1" Width="240" Height="200" Margin="0,18,0,4">
                <ItemsControl ItemsSource="{Binding OrbitNodes}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="240" Height="200" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MiniLauncherOrbitNodeViewModel}">
                            <Line X1="120" Y1="100"
                                  X2="{Binding LineX2}" Y2="{Binding LineY2}"
                                  Stroke="{DynamicResource Token.AccentBrush}"
                                  StrokeThickness="1"
                                  StrokeDashArray="3,3"
                                  Opacity="0.35" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Ellipse Width="58" Height="58"
                         Stroke="{DynamicResource Token.AccentBrush}"
                         StrokeThickness="2"
                         Fill="{DynamicResource Token.AccentSubtleBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding CenterLabel}"
                           Foreground="{DynamicResource Token.TextAccentBrush}"
                           FontFamily="{DynamicResource Token.FontUi}"
                           FontSize="{StaticResource Token.TextSm}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           MaxWidth="48"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <ItemsControl ItemsSource="{Binding OrbitNodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="240" Height="200" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding NodeLeft}" />
                            <Setter Property="Canvas.Top" Value="{Binding NodeTop}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MiniLauncherOrbitNodeViewModel}">
                            <Button Command="{Binding ActivateCommand}"
                                    Width="32" Height="32"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Padding="0"
                                    Cursor="Hand"
                                    ToolTip="{Binding Label}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Chrome"
                                                Background="{DynamicResource Token.BgSubtleBrush}"
                                                BorderBrush="{DynamicResource Token.BorderDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Token.RadiusMd}">
                                            <iconPacks:PackIconLucide Kind="{Binding Item.Kind, Converter={StaticResource KindToLucideKindConverter}}"
                                                                      Width="14"
                                                                      Height="14"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Token.AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Item list: filtered, indexed, Ctrl+N to open -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                    BorderThickness="0,1,0,1">
                <ScrollViewer MaxHeight="288"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MiniLauncherListItemViewModel}">
                                <Button Command="{Binding ActivateCommand}"
                                        Style="{StaticResource Simple.GhostButton}"
                                        Height="44"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="16,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <iconPacks:PackIconLucide Kind="{Binding Kind, Converter={StaticResource KindToLucideKindConverter}}"
                                                                  Width="16"
                                                                  Height="16"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,12,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="{StaticResource Token.TextSm}"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource Token.TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplayPath}"
                                                       FontFamily="{DynamicResource Token.FontMono}"
                                                       FontSize="{StaticResource Token.TextXs}"
                                                       Margin="0,1,0,0"
                                                       Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Padding="6,2"
                                                Background="{DynamicResource Token.BgSubtleBrush}"
                                                BorderBrush="{DynamicResource Token.BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Token.RadiusXs}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasIndex, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding IndexLabel}"
                                                       FontFamily="{DynamicResource Token.FontMono}"
                                                       FontSize="{StaticResource Token.TextXs}"
                                                       Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Footer hint bar (or status when launch fails) -->
            <Border Grid.Row="3"
                    Padding="16,10"
                    Background="{DynamicResource Token.BgSubtleBrush}">
                <Grid>
                    <!-- Status text shown when a launch fails (dead path, offline, etc.) -->
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="{StaticResource Token.TextXs}"
                               Foreground="{DynamicResource Token.StatusWarningBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Default hint bar (hidden when StatusText is set). -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ctrl+1..9"
                                       FontFamily="{DynamicResource Token.FontMono}"
                                       FontSize="{StaticResource Token.TextXs}"
                                       Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                            <TextBlock Text=" open slot"
                                       FontSize="{StaticResource Token.TextXs}"
                                       Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                       Margin="2,0,16,0" />
                            <TextBlock Text="Enter"
                                       FontFamily="{DynamicResource Token.FontMono}"
                                       FontSize="{StaticResource Token.TextXs}"
                                       Foreground="{DynamicResource Token.TextSecondaryBrush}" />
                            <TextBlock Text=" open first match"
                                       FontSize="{StaticResource Token.TextXs}"
                                       Foreground="{DynamicResource Token.TextTertiaryBrush}"
                                       Margin="2,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Ctrl+Shift+G to summon"
                                   FontFamily="{DynamicResource Token.FontMono}"
                                   FontSize="{StaticResource Token.TextXs}"
                                   Foreground="{DynamicResource Token.TextTertiaryBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
