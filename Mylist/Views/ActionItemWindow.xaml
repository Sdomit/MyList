<Window x:Class="MyList.Views.ActionItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Action Item"
        Width="640"
        Height="520"
        MinWidth="620"
        MinHeight="480"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStartupLocation="CenterOwner">
    <Border Margin="12"
            Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Token.RadiusXl}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="18"
                       FontWeight="SemiBold" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,14,0,12"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Type"
                               Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableTypes}"
                              SelectedItem="{Binding SelectedType}" />

                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Name" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Script content" Margin="0,12,0,6" />
                        <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 Height="220"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas" />

                        <TextBlock Text="Working directory" Margin="0,12,0,6" />
                        <TextBox Text="{Binding WorkingDirectory}" />

                        <CheckBox Content="Run as administrator"
                                  Margin="0,12,0,0"
                                  IsChecked="{Binding RunAsAdmin}" />
                    </StackPanel>

                    <Border Margin="0,12,0,0"
                            Padding="10"
                            Background="{DynamicResource SurfaceElevated}"
                            CornerRadius="{StaticResource Token.RadiusLg}">
                        <TextBlock Text="Separators are plain collection-local dividers. They do not run, copy, or appear in smart collections."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="OnCancel" />
                <Button Content="{Binding ConfirmButtonText}"
                        Width="120"
                        Style="{StaticResource Simple.PrimaryButton}"
                        Click="OnSave" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
