<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MyList skin - custom pill look with the bundled brand fonts -->
    <CornerRadius x:Key="Token.Skin.ControlRadius">9999</CornerRadius>
    <CornerRadius x:Key="Token.Skin.InputRadius">8</CornerRadius>
    <CornerRadius x:Key="Token.Skin.RowRadius">8</CornerRadius>
    <CornerRadius x:Key="Token.Skin.MenuRadius">8</CornerRadius>
    <CornerRadius x:Key="Token.Skin.ChipRadius">9999</CornerRadius>

    <FontFamily x:Key="Token.FontSans">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="Token.FontMono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="Token.FontUi">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="Token.FontDisplay">pack://application:,,,/Assets/Fonts/#Plus Jakarta Sans</FontFamily>
</ResourceDictionary>
