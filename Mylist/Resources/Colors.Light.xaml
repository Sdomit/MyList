<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#F6F7F9</Color>
    <Color x:Key="SurfaceBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#F2F4F7</Color>
    <Color x:Key="AccentColor">#2B6DFF</Color>
    <Color x:Key="AccentSoftColor">#DDE9FF</Color>
    <Color x:Key="TextPrimaryColor">#1B1E26</Color>
    <Color x:Key="TextSecondaryColor">#5A6372</Color>
    <Color x:Key="BorderColor">#D7DCE5</Color>
    <Color x:Key="ItemHoverColor">#EEF3FF</Color>
    <Color x:Key="ItemSelectedColor">#D8E6FF</Color>
    <Color x:Key="ItemStateHoverColor">#E0EDFF</Color>
    <Color x:Key="ItemStatePressColor">#AFCBFF</Color>
    <Color x:Key="ShadowColor">#33000000</Color>
    <Color x:Key="ControlDisabledColor">#C9CFDA</Color>
    <Color x:Key="SelectionForegroundColor">#FFFFFF</Color>
    <Color x:Key="ContentAreaBackgroundColor">#F3F5F8</Color>
    <Color x:Key="ToolbarBackgroundColor">#FFFFFF</Color>
    <Color x:Key="OverlayBackdropColor">#66000000</Color>

    <SolidColorBrush x:Key="AppBackground" Color="{DynamicResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="{DynamicResource SurfaceBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="{DynamicResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource AccentSoftColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="ItemHover" Color="{DynamicResource ItemHoverColor}" />
    <SolidColorBrush x:Key="ItemSelected" Color="{DynamicResource ItemSelectedColor}" />
    <SolidColorBrush x:Key="ShadowBrush" Color="{DynamicResource ShadowColor}" />

    <SolidColorBrush x:Key="ControlBackground" Color="{DynamicResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="ControlForeground" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="ControlBorder" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="ControlHover" Color="{DynamicResource ItemHoverColor}" />
    <SolidColorBrush x:Key="ControlPressed" Color="{DynamicResource ItemSelectedColor}" />
    <SolidColorBrush x:Key="ControlDisabled" Color="{DynamicResource ControlDisabledColor}" />
    <SolidColorBrush x:Key="SelectionBackground" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="SelectionForeground" Color="{DynamicResource SelectionForegroundColor}" />
    <SolidColorBrush x:Key="ContentAreaBackground" Color="{DynamicResource ContentAreaBackgroundColor}" />
    <SolidColorBrush x:Key="ToolbarBackground" Color="{DynamicResource ToolbarBackgroundColor}" />
    <SolidColorBrush x:Key="OverlayBackdrop" Color="{DynamicResource OverlayBackdropColor}" />
    <SolidColorBrush x:Key="ItemStateHoverBrush" Color="{DynamicResource ItemStateHoverColor}" />
    <SolidColorBrush x:Key="ItemStatePressBrush" Color="{DynamicResource ItemStatePressColor}" />
</ResourceDictionary>
