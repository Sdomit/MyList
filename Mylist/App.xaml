<Application x:Class="MyList.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MyList.Converters"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Resources/Colors.Dark.Blue.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
                <ResourceDictionary Source="Resources/FluentControls.xaml" />
                <ResourceDictionary Source="Themes/SimpleControls.xaml" />
                <ResourceDictionary Source="Themes/Chips.xaml" />
                <ResourceDictionary Source="Themes/SegmentedControl.xaml" />
                <ResourceDictionary Source="Resources/Density.Comfortable.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <converters:AccentPaletteToBrushConverter x:Key="AccentPaletteToBrushConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:MultiplyValueConverter x:Key="MultiplyValueConverter" />
            <converters:ItemCollectionActionContextConverter x:Key="ItemCollectionActionContextConverter" />
            <converters:CollectionEntryActionContextConverter x:Key="CollectionEntryActionContextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
