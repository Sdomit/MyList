<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyList</AssemblyName>
    <RootNamespace>MyList</RootNamespace>
    <Company>Sarmad Domit</Company>
    <Product>MyList</Product>
    <AssemblyTitle>MyList</AssemblyTitle>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;dist\**;bin2\**;obj2\**;obj_pub\**;handoff-pr1-tokens\**;handoff-pr2-themes\**;handoff-pr3-accent\**;handoff-pr4-launcher\**;handoff-pr5-chips\**;handoff-pr6-spark\**;handoff-pr7-ring\**;My list (1)\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="desktops.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="icons\\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="icons\\*.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\\Fonts\\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="*" />
  </ItemGroup>

  <!--
    Single-file publish to an external -o dir drops loose Content: icon.ico is the
    embedded ApplicationIcon (deduped), and the icons globs don't flow through.
    Copy the runtime assets into the publish folder explicitly so a published build
    matches the build output and the app finds icon.ico / icons at runtime.
  -->
  <Target Name="CopyRuntimeAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_RuntimeAsset Include="icon.ico;desktops.png" />
      <_RuntimeAssetIcons Include="icons\*.ico;icons\*.cur" />
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeAsset)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RuntimeAssetIcons)" DestinationFolder="$(PublishDir)icons" SkipUnchangedFiles="true" />
  </Target>

</Project>
