<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyList</AssemblyName>
    <RootNamespace>MyList</RootNamespace>
    <Company>Sarmad Domit</Company>
    <Product>MyList</Product>
    <AssemblyTitle>MyList</AssemblyTitle>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.7.0</Version>
    <!-- AssemblyInformationalVersion is auto-composed by the SDK as
         $(Version)+$(SourceRevisionId). SourceRevisionId is stamped from
         git below so it stays accurate for every build, no manual bump. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="desktops.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="icons\\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="icons\\*.cur">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\\Fonts\\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="*" />
  </ItemGroup>

  <!-- Stamp the current git commit SHA into SourceRevisionId before assembly
       metadata is generated. The SDK then appends it to InformationalVersion
       as "1.2.1+<full-sha>", which BuildInfo.DisplayString trims to 7 chars
       at runtime. ContinueOnError keeps non-git builds (CI tarballs) working. -->
  <Target Name="StampSourceRevisionId" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse HEAD"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
  </Target>

  <!--
    Single-file publish to an external -o dir drops loose Content: icon.ico is the
    embedded ApplicationIcon (deduped), and the icons globs don't flow through.
    Copy the runtime assets into the publish folder explicitly so a published build
    matches the build output and the app finds icon.ico / icons at runtime.
  -->
  <Target Name="CopyRuntimeAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_RuntimeAsset Include="icon.ico;desktops.png" />
      <_RuntimeAssetIcons Include="icons\*.ico;icons\*.cur" />
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeAsset)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RuntimeAssetIcons)" DestinationFolder="$(PublishDir)icons" SkipUnchangedFiles="true" />
  </Target>

</Project>
