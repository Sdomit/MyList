<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:MyList.Helpers"
                    xmlns:models="clr-namespace:MyList.Models">
    <helpers:KindToBadgeLetterConverter x:Key="KindToBadgeLetterConverter" />
    <helpers:KindToLucideKindConverter x:Key="KindToLucideKindConverter" />

    <!-- Chip.Kbd: shared keyboard-shortcut chip chrome.
         Used by MainWindow ListItemTemplate (PR #5) and CommandPalette rows (PR #10).
         Caller controls Visibility/Opacity for animation; this style provides chrome only. -->
    <Style x:Key="Chip.Kbd" TargetType="ContentControl">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{DynamicResource Token.FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource Token.TextXs}" />
        <Setter Property="Foreground" Value="{DynamicResource Token.TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource Token.BgSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Token.BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Padding="{TemplateBinding Padding}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            CornerRadius="{DynamicResource Token.Skin.ChipRadius}"
                            Effect="{StaticResource Token.ShadowXs}">
                        <ContentPresenter TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip.Type: cross-surface content-kind badge (palette + clipboard + duplicates).
         Tag carries the ContentKind. Tag == null collapses the chip.
         Saturated foreground on pastel background (GitHub-label pattern) avoids the
         white-on-pastel WCAG-AA failure on Clip. -->
    <Style x:Key="Chip.Type" TargetType="ContentControl">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{DynamicResource Token.FontMono}" />
        <Setter Property="FontSize" Value="{StaticResource Token.TextXs}" />
        <Setter Property="FontWeight" Value="{StaticResource Token.WeightMedium}" />
        <Setter Property="Background" Value="{DynamicResource Token.MyList.TypeFileBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Token.TypeFileForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Token.RadiusXs}">
                        <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag, Converter={StaticResource KindToBadgeLetterConverter}}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static models:ContentKind.File}">
                <Setter Property="Background" Value="{DynamicResource Token.MyList.TypeFileBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Token.TypeFileForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static models:ContentKind.Folder}">
                <Setter Property="Background" Value="{DynamicResource Token.MyList.TypeFolderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Token.TypeFolderForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static models:ContentKind.Mtab}">
                <Setter Property="Background" Value="{DynamicResource Token.MyList.TypeMtabBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Token.TypeMtabForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static models:ContentKind.Clip}">
                <Setter Property="Background" Value="{DynamicResource Token.MyList.TypeClipBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Token.TypeClipForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static models:ContentKind.Action}">
                <Setter Property="Background" Value="{DynamicResource Token.MyList.TypeActionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Token.TypeActionForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
