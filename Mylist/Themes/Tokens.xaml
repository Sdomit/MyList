    <SolidColorBrush x:Key="Token.OverlayBrush" Color="{DynamicResource Token.OverlayColor}" />
    <SolidColorBrush x:Key="Token.CloseHoverBrush" Color="{DynamicResource Token.CloseHoverColor}" />
