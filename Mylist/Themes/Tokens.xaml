    <SolidColorBrush x:Key="AccentSoft" Color="{DynamicResource Token.AccentSoftColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource Token.TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource Token.TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource Token.BorderSoftColor}" />
