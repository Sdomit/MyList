    <SolidColorBrush x:Key="Token.StatusBadBackgroundBrush" Color="{DynamicResource Token.StatusBadBackgroundColor}" />
    <SolidColorBrush x:Key="Token.StatusUnknownBrush" Color="{DynamicResource Token.StatusUnknownColor}" />
