    <DropShadowEffect x:Key="Token.ShadowXs" BlurRadius="2" ShadowDepth="1" Opacity="0.30" Color="#000000" />
    <DropShadowEffect x:Key="Token.ShadowSm" BlurRadius="4" ShadowDepth="1" Opacity="0.40" Color="#000000" />
    <DropShadowEffect x:Key="Token.ShadowMd" BlurRadius="12" ShadowDepth="3" Opacity="0.45" Color="#000000" />
    <DropShadowEffect x:Key="Token.ShadowLg" BlurRadius="32" ShadowDepth="8" Opacity="0.55" Color="#000000" />
    <DropShadowEffect x:Key="Token.ShadowXl" BlurRadius="64" ShadowDepth="16" Opacity="0.65" Color="#000000" />
    <SolidColorBrush x:Key="Token.ShadowFocusBrush" Color="#663B82F6" />

    <!-- CSS radius tokens -->
    <CornerRadius x:Key="Token.RadiusXs">3</CornerRadius>
    <CornerRadius x:Key="Token.RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="Token.RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="Token.RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="Token.RadiusXl">10</CornerRadius>
    <CornerRadius x:Key="Token.Radius2Xl">14</CornerRadius>
    <CornerRadius x:Key="Token.Radius3Xl">20</CornerRadius>
    <CornerRadius x:Key="Token.RadiusFull">9999</CornerRadius>

    <!-- CSS font tokens -->
    <FontFamily x:Key="Token.FontUi">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Token.FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Token.FontMono">Cascadia Code, Consolas</FontFamily>

    <!-- CSS easing tokens -->
    <KeySpline x:Key="Token.EaseStandard">0.4,0 0.2,1</KeySpline>
    <KeySpline x:Key="Token.EaseDecel">0,0 0.2,1</KeySpline>
    <KeySpline x:Key="Token.EaseSpring">0.34,1 0.64,1</KeySpline>

