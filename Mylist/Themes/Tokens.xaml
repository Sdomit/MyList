    <sys:Double x:Key="Token.Space0">0</sys:Double>
    <sys:Double x:Key="Token.Space1">1</sys:Double>
    <sys:Double x:Key="Token.Space2">2</sys:Double>
    <sys:Double x:Key="Token.Space3">3</sys:Double>
    <sys:Double x:Key="Token.Space4">4</sys:Double>
    <sys:Double x:Key="Token.Space5">5</sys:Double>
    <sys:Double x:Key="Token.Space6">6</sys:Double>
