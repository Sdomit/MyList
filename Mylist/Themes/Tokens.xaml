    <Color x:Key="Token.AccentVioletMuteColor">#3D7C3AED</Color>

    <!-- Brushes for every semantic color token -->
    <SolidColorBrush x:Key="Token.AccentBrush" Color="{DynamicResource Token.AccentColor}" />
    <SolidColorBrush x:Key="Token.AccentHoverBrush" Color="{DynamicResource Token.AccentHoverColor}" />
    <SolidColorBrush x:Key="Token.AccentSoftBrush" Color="{DynamicResource Token.AccentSoftColor}" />
