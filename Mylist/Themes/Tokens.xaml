    <SolidColorBrush x:Key="Token.BorderHairBrush" Color="{DynamicResource Token.BorderHairColor}" />
    <SolidColorBrush x:Key="Token.BorderSoftBrush" Color="{DynamicResource Token.BorderSoftColor}" />
